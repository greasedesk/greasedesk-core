// File: prisma/schema.prisma
// Last edited: 2025-11-18 15:10 Europe/London
// Notes:
// - Normalised whitespace (removed non-breaking spaces that can break prisma fmt).
// - Prices/taxes now use @db.Decimal(12,2) for consistent SQL types.
// - Kept your multi-tenant structure. Relation names preserved.
// - Safe defaults; no preview features required.

// ───────────────────────────────────────────────────────────────────────────────
// Generators & Datasource
// ───────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // Explicit binary targets so Prisma doesn't try to fetch a RHEL engine on Vercel
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — runtime
  // Migrations MUST use the direct (unpooled) endpoint: pg_advisory_lock is SESSION-scoped,
  // and through a pooler the lock sticks to an immortal pool connection (2026-07-12 incident:
  // builds blocked ~24h on a lock orphaned this way). Prisma migrate/status read this.
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────────────────────
// Enums
// ───────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SITE_MANAGER
  STANDARD
}

// Job card lifecycle — stable lowercase keys; translated for display (never shown raw).
// Transitions + per-transition authority live in lib/jobcard-status.ts (the one place).
enum JobCardStatus {
  draft
  quoted
  accepted
  declined
  in_progress
  invoiced
  paid
  done
  cancelled
  no_show
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

// Invoice lifecycle (bank-style). issued = number assigned, editable. paid_pending = attested
// paid, snapshot FROZEN, reversible in the clearance window, customer told NOTHING yet.
// paid = CONFIRMED by the clearance cron (receipt sent) — true settlement, the income grain.
enum InvoiceStatus {
  issued
  paid_pending
  paid
  settled // warranty terminal state: £0, no charge, closed at issue — never collects, never AR
  // ISSUED IN ERROR AND RETIRED. The document is RETAINED, not deleted: VATREC5010 accepts a break
  // in a sequential series "as long as you retain the cancelled or spoiled invoice in your
  // accounting records, or you can provide an explanation for the break in sequence". A void keeps
  // its number, its frozen lines and its snapshots, and carries the explanation on the row —
  // which is why voiding requires frozen lines, unlike the empty husk `unlock` leaves behind.
  // A void is NOT a credit note: a credit note is a countervailing document sent to a customer for
  // a decrease in consideration (VATREC13040), and needs its own series and particulars.
  void
}

// Chargeable vs warranty invoices draw from SEPARATE counters — both independently gapless.
// A comeback must never burn a chargeable number.
enum InvoiceSeries {
  chargeable
  warranty
  // HISTORICAL: a record of an invoice issued under a PREVIOUS system. It is not a document
  // anyone holds — the customer's copy carries the old system's number, kept in external_ref.
  // Its own number comes from a THIRD, independent counter so recording history never spends a
  // VAT number. 177 TMBS entries were hand-keyed through the chargeable path before this existed,
  // which is exactly what it prevents. Excluded from the VAT return BY CONSTRUCTION: every VAT
  // read names `series: 'chargeable'`, so a historical entry can never re-declare output tax
  // already declared elsewhere.
  historical
}

// Payment-method clearance behaviour: instant = no window (cash in the till); windowed = the
// tenant's clearance window then cron-confirm; manual = pending until explicitly confirmed
// (warranty companies / EMAC — external timescales, never auto-confirmed).
enum PaymentClearance {
  instant
  windowed
  manual
}

// Cost-capture (per-site P&L foundation). Raw cost grains only — no aggregation in-schema.
enum CostType {
  salary // amount_pennies = annual salary
  hourly // amount_pennies = hourly rate
}

enum CostCadence {
  monthly
  quarterly
  annual
}

/// How a cost lands in the figures. SPREAD answers "what does a month of trading cost me" and is
/// the right default for break-even; FALLS answers "what leaves the bank in June". Over a full
/// cycle the two MUST total the same — the setting distributes a cost, it never changes it.
enum CostCharge {
  spread
  falls
}

enum OverheadPeriod {
  weekly
  monthly
  annual
}

// The GATE projection of the Stripe subscription (cache of Stripe's truth, webhook-written).
// 'lapsed' NOT 'suspended' (ruling 2026-07-13): "suspended" invites barring the door, and barring
// the door bars a garage from its own statutory records. lapsed = READ-ONLY-FOREVER-FREE, never
// locked out. Read only via lib/billing.ts::canWrite — never inline.
enum BillingStatus {
  ok // trialing or active — full write access
  grace // past_due: Stripe is retrying; writes still allowed, warned
  lapsed // canceled / unpaid: reads stay open forever, writes blocked, nothing deleted
}

/// WHICH CLOCK MAKES A DUE ITEM DUE — STATED, never inferred from which column happens to be
/// filled. A date and a mileage can BOTH be present ("by March, or 60k, whichever first" is a real
/// thing a mechanic says) and only one is binding; letting the presence of a value carry the
/// decision is the demo_expires_at lesson — one column answering two questions.
/// How precise a due date is. A manufacturer's interval is a MONTH ("11/2025"); an MOT expiry is a
/// day. Both are honest and they must not be printed the same way.
enum DueDatePrecision {
  day
  month
}

enum DueBasis {
  date
  mileage
  next_service
  /// BOTH values required, and the EARLIER projected one binds. This is what a garage actually
  /// writes — "Oil service due in 10k miles or 11/2025" — and neither leg alone is the answer:
  /// choose `date` and a high-mileage car is reminded late; choose `mileage` and a low-mileage car
  /// is never reminded at all. Ordering it needs a mileage rate (lib/odometer); without one the
  /// DATE still bounds it, and the caller is told the mileage leg went unevaluated.
  whichever_first
}

/// WHAT THE CUSTOMER SAID — THREE states, and the distinction is the whole commercial point.
/// `not_raised` (nobody asked them yet) and `declined` (they were asked and said no) are different
/// facts, and only `declined` is a lead. Collapsing them would make declined vanishingly rare and
/// silently destroy the marketing list this model exists to build.
enum DueItemResponse {
  not_raised
  declined
  agreed_later
  /// They answered, and what they answered was "ring me about it". A real, distinct, actionable
  /// state: not `not_raised` (they WERE asked), not `declined` (they have not said no), and not
  /// `agreed_later` (they have not said yes). Added 2026-08-19 with the customer-facing report,
  /// because mapping a call request onto any of the other three silently loses it.
  wants_call
}

/// WHAT THE CUSTOMER THEMSELVES TAPPED, on the intake report.
enum CustomerAnswer {
  yes
  no
  call_me
}

/// Where on the car. Four corners, named as a mechanic names them.
enum TyreCorner {
  front_left
  front_right
  rear_left
  rear_right
}

/// What is fitted. Run-flats matter because they cannot be repaired the same way and cost more to
/// replace — a garage quoting a replacement needs to know before it phones the customer.
enum TyreType {
  summer_standard
  summer_runflat
  winter_standard
  winter_runflat
}

enum ItemType {
  labour
  part
  misc
  fixed // published fixed-price service bundle (price-led, cost-optional); its own estimate section
}

// Shared, system-defined category for a Profit Centre (typed business unit).
// Cross-site reporting slices by this. Add new values via migration as needed.
enum ProfitCentreCategory {
  repairs
  mot
  spraybooth
  car_sales
}

// Physical unit within a Profit Centre; these become the diary's columns.
enum ResourceType {
  lift
  mot_bay
  spray_booth
  other // any other bookable revenue resource (rolling road, wash bay, …) — name carries the detail
}

// ───────────────────────────────────────────────────────────────────────────────
// Core multi-tenant models
// ───────────────────────────────────────────────────────────────────────────────

model Group {
  id                            String  @id @default(uuid())
  group_name                    String
  /// WHAT CUSTOMERS CALL YOU. `group_name` above is the REGISTERED LEGAL NAME and stays on VAT
  /// documents; this is the shopfront. NULL = not set, which is the common case — every reader
  /// falls back with `trading_name || group_name`, and the writer normalises '' to NULL so the
  /// column means "not set" rather than carrying an empty string N readers must defend against.
  trading_name                  String?
  company_number                String?
  vat_number                    String?
  // Setup-checklist APPLICABILITY declarations (item-13) — NOT "done" flags (completion is always
  // derived from real rows). A sole trader legitimately has no company number and no employees, so
  // these let the owner mark those two signals "not applicable" instead of forever "to do". Scoped
  // to EXACTLY these two signals; resources + financial items are always applicable. Read only via
  // lib/setup-signals.
  employees_not_applicable      Boolean @default(false)
  company_number_not_applicable Boolean @default(false)
  // Master switch: VAT applies anywhere (quotes/invoices/overheads) only when true. Default true
  // preserves existing tenants' VAT-as-now behaviour; sub-threshold garages turn it off. Resolved
  // via lib/tax.ts (getTaxProfile → is_registered) and gated in computeTax — never scattered.
  vat_registered                Boolean @default(true)
  // Company-wide default VAT rate (only meaningful when registered). LEGACY Decimal-percent column,
  // kept in lockstep with tax_default_rate_bp (the canonical integer-basis-point source since the
  // TaxProfile refactor). getTaxProfile reads bp, falling back to ×100 of this while backfill lands.
  default_vat_rate              Decimal @default(20) @db.Decimal(5, 2)
  address                       String?
  // Marketing attribution captured at signup from a public `?ref=` parameter (DORMANT — no rep
  // system yet; we just never lose the attribution, which is expensive to retrofit). Sanitised +
  // capped at write; null when the signup carried no ref.
  signup_ref                    String?

  // ── TaxProfile (item-13 onboarding groundwork). The Group is the LEGAL entity that files one
  // tax return, so tax identity lives here; currency + locale are TRADING identity and stay on Site
  // (a UK group may open a Dublin site — same VAT branch, different rate). Assembled + consumed ONLY
  // via lib/tax.ts::getTaxProfile / computeTax. tax_name is Group.tax_label RELOCATED (one value,
  // seeded from locale_profiles at onboarding — never a third name source). ──
  // COUNTRY OF RECORD (country-first onboarding). NULL until the country step runs → the step's
  // completion signal. Drives currency, timezone options, tax_model and tax_label from the profile
  // (lib/locale-profiles). tax_country_code is kept in lockstep, derived from this.
  country_code        String? // ISO 3166-1 alpha-2; NULL until chosen
  tax_country_code    String  @default("GB") // ISO 3166-1 alpha-2 (derived from country_code)
  tax_model           String  @default("vat") // 'vat' (only live branch) | 'sales_tax' | 'gst_split' (throw NotImplemented)
  tax_default_rate_bp Int? // integer BASIS POINTS (2000 = 20%); NULL until backfilled → derive ×100 of default_vat_rate
  prices_include_tax  Boolean @default(false) // false for UK B2B (line prices are ex-tax)

  // Invoice number DISPLAY format (per-tenant). Rendered via lib/invoice-number.ts::formatInvoiceNumber.
  // FY-prefix is a format string, never a reset. Padding default 4 (Xero-style "0001").
  invoice_prefix            String   @default("")
  invoice_pad_width         Int      @default(4)
  // Fiscal-year DISPLAY segment (e.g. INV-26-0042): 0 = off, 2 or 4 digits of the year the FY
  // started in. The counter underneath stays continuous — FY is formatting, never a reset.
  invoice_fy_digits         Int      @default(0)
  fy_start_month            Int      @default(4) // 1-12; UK default April
  // Warranty-series prefix (comeback £0 invoices) — the filter key for the future comebacks tile.
  invoice_warranty_prefix   String   @default("W")
  // Historical-series prefix. Deliberately distinct so a historical number can never be mistaken
  // for a VAT invoice number at a glance, in the list or on a document.
  invoice_historical_prefix String   @default("H")
  invoice_credit_note_prefix String  @default("CN")
  // "Sent with GreaseDesk" footer line in invoice EMAILS (never the PDF). Tiering policy later.
  invoice_email_footer      Boolean  @default(true)
  // Bank-style clearance window (hours): mark-paid holds reversible + silent this long before the
  // cron confirms and sends the receipt. Flat window; working-day-aware is a banked refinement.
  paid_confirm_window_hours Int      @default(24)
  // --- Invoicing tab settings (ADMIN; Settings → Invoicing) ---
  // WHERE GARAGE-FACING OPERATIONAL NOTIFICATIONS GO — "a customer accepted a quote", "an email
  // arrived". NOT billing (billing_email is an IDENTITY key: onboarding upserts by it and
  // update-rates recovers group_id from it, so it must not be repurposed). NOT the customer-facing
  // reply address (invoice_reply_to is what a customer sees and replies to). Three addresses,
  // three jobs. NULL = fall back through lib/ops-email to invoice_reply_to then billing_email, so
  // an existing tenant keeps exactly today's behaviour until someone sets this deliberately.
  ops_email                 String?
  invoice_reply_to          String? // business Reply-To on invoice emails (fallback: billing_email)
  /// Display name on the GreaseDesk-owned From line. A NARROWING of trading_name, not a peer:
  /// the fallback chain is `invoice_sender_name || trading_name || group_name`, so a garage that
  /// sets only a trading name gets it here too. Set this ONLY when the email From should differ
  /// from the trading name — otherwise three name fields is how a garage ends up with three names
  /// and no idea which appears where. NULL = use the trading name.
  invoice_sender_name       String?
  invoice_footer_text       String? // payment terms / footer block — multi-line, rendered on the document
  invoice_bcc               String? // garage-copy BCC (fallback: billing_email)
  logo_r2_key               String? // tenant logo in R2 ({group}/branding/…), top-centre of the PDF
  // Per-tenant leave-type colour overrides (type→hex; defaults = Okabe–Ito in lib/leave-types;
  // admin-remappable for colour-blind accessibility). Read via resolveLeaveColours only.
  leave_type_colours        Json?
  /// Show cars whose quote has lapsed on the marketing board. An OFF SWITCH for something that is
  /// on, not an opt-in — the opposite polarity from Site.intake_prompt_*, deliberately: a lapsed
  /// quote is a lead every garage has, where a diagnostic scan is equipment some garages lack.
  marketing_expired_quotes  Boolean @default(true)
  /// How long a snooze lasts, in days. NULL = never set, so lib/marketing-lists::SNOOZE_DAYS
  /// applies — NOT "zero days" and not "30". Writing 30 here for everyone would make a deliberate
  /// choice of 30 indistinguishable from nobody having been asked, for ever.
  marketing_snooze_days     Int?
  /// Days BEFORE expiry at which a live quote moves from Warm to Hot. NULL = only on expiry, which
  /// is a real answer rather than a stand-in for 0: it says "we never want it early".
  marketing_quote_hot_days  Int?
  status_colours            Json? // diary job-status band → curated-palette hex (lib/status-colours); null keys fall back to defaults. One palette per tenant (a mechanic moving sites shouldn't relearn colours).
  // Tax LABEL only (admin-typed: VAT/GST/Sales Tax…) — never derived from country; rate stays in Company Details.
  tax_label                 String   @default("VAT")
  phone                     String? // company-level contact number — the FALLBACK when a site has none (customer-facing escape hatch)
  whatsapp                  String? // company-level WhatsApp, stored E.164 DIGITS (447700900123). INDEPENDENT of phone — a garage may run WhatsApp on a different number, or not at all.
  billing_email             String   @unique
  is_franchise_grp          Boolean  @default(false)
  created_at                DateTime @default(now())

  // Human-facing, immutable account reference (GB-GD<n>), auto-assigned from a Postgres
  // sequence via a column default (atomic / collision-safe). Never updated by any API.
  /**
   * /**
   * WRITTEN THE WAY POSTGRES STORES IT, not the way it is nicest to type. Postgres normalises the
   * literal in a DEFAULT expression and adds the cast, so `'GB-GD'` comes back as `'GB-GD'::text`.
   * Prisma compares these as strings, so the tidier spelling made `migrate diff` propose re-setting
   * the default to the value it already had — for ever, because applying it would normalise straight
   * back. A permanent phantom in the diff is worse than an ugly string: it is the noise a real drift
   * hides inside. Verified against the database, not guessed.
   */
  ref String @unique @default(dbgenerated("('GB-GD'::text || nextval('group_ref_seq'::regclass))"))

  // ── STRIPE CONNECT: THE GARAGE'S OWN PAYMENTS ACCOUNT ─────────────────────────────────────────
  // ⚠ VESTIGIAL AS OF THE PROVIDER-CONNECTION MIGRATION. Every column below was backfilled into
  // ProviderConnection (provider = 'stripe') and NOTHING reads or writes them any more. Do not add
  // a reader: lib/provider-connection is the store and lib/payment-providers derives the state.
  // Retained rather than dropped because they are the only surviving record of the pre-migration
  // state if the backfill ever has to be audited, and dropping them buys nothing.
  //
  // Kept for the record — the reasoning that produced this shape, which still governs the new table:
  // deliberately NOT on GroupBilling (that mirrors GreaseDesk's OWN subscription, and two Stripe
  // relationships in one row get confused eventually, one of which decides whether a garage can
  // trade); and STANDARD accounts (ruling 2026-08-13) because the Express-equivalent config forces
  // `losses.payments: application`, putting every connected garage's unrecoverable chargebacks onto
  // GreaseDesk — an open-ended liability against a £75/month product.
  stripe_account_id       String?      @unique // acct_…
  /**
   * WHICH MODE THIS ACCOUNT LIVES IN. Straight from the account's own `livemode`, never inferred.
   * A test `acct_…` and a live `acct_…` are indistinguishable by inspection, and the platform key
   * cannot be trusted to tell you either — production runs a RESTRICTED live key (`rk_live_…`) that
   * fails an `sk_live_` prefix test, which is how mode was got wrong once already and then repeated
   * from a stale note. Same fix as StripeEvent.livemode, one table over, on the object where getting
   * it wrong is worst: a garage's real KYC submitted into a sandbox is a wasted onboarding nobody
   * can undo.
   * NULLABLE = unknown, for any row predating this column. Live code refuses an account it cannot
   * confirm, and says so in words.
   */
  stripe_account_livemode Boolean?
  stripe_charges_enabled  Boolean      @default(false)
  stripe_payouts_enabled  Boolean      @default(false)
  // Stripe's own reason string, stored VERBATIM. Paraphrasing it here is how the product ends up
  // telling a garage something Stripe's dashboard contradicts.
  stripe_disabled_reason  String?
  // requirements.currently_due, kept so the product can SAY what is outstanding rather than leaving
  // the garage to discover it in an email from Stripe.
  stripe_requirements_due Json?
  stripe_connected_at     DateTime?
  stripe_disconnected_at  DateTime?
  status                  TenantStatus @default(trial) // tenant lifecycle (console-managed later)
  trial_ends_at           DateTime? // set on signup to now + TRIAL_DAYS
  // SuperAdmin soft-delete (operator portal). Non-null = ARCHIVED: login blocked (authorize()),
  // hidden from active use, ALL data kept, fully reversible (un-archive clears it). Set only via
  // /api/superadmin/archive — never a tenant-facing action.
  archived_at             DateTime?
  // GreaseDesk-owned tenant (gate/test), never a paying customer. Set EXPLICITLY, never inferred from
  // the name (a real "ZZ Motors" must not silently vanish). Excluded from the tenant count, forecast,
  // and any revenue/commission figure; badged in the Engine Room. NULL = a normal customer tenant.
  is_internal             Boolean?

  // ── FREE: A DECISION, WITH AN AUTHOR AND A DATE ───────────────────────────────────────────────
  // A garage we have decided not to charge. NOT the same as is_internal, which means OURS — a beta
  // partner, a friend's shop or a reseller's own workshop is none of ours and still pays nothing,
  // and a third boolean answering an adjacent question is exactly how is_demo and is_internal came
  // to be one flag doing two jobs (see lib/demo-tenant).
  //
  // free_since NULL = a normal paying tenant, which is nearly all of them. The DATE is the decision;
  // a reason with no date is not one, and isFree() reads the date alone for that reason. Read ONLY
  // through lib/demo-tenant::isFree, and folded into neverSubscribes — a free tenant has no
  // subscription and never will, which is the sentence that predicate already carries.
  //
  // Deliberately NOT a billing status: GroupBilling mirrors Stripe's truth and a webhook reads it,
  // so writing "free" there would be a claim about a Stripe object that does not exist. lib/onboarding
  // refused that once already and the reason still holds.
  //
  // NULL = a normal paying tenant, which is every row that exists today and nearly every one after.
  // Nobody has decided anything about them, and that absence is the honest state — never backfilled.
  free_since              DateTime?
  // WHY, and it is not decoration: "this tenant pays nothing, forever" is exactly the kind of fact
  // that is indistinguishable from a mistake six months later. Same argument as the void reason and
  // the phone-step exemption. NULL only on rows that predate the column.
  free_reason             String?

  // --- Permission config (per-tenant admin toggles that relax STANDARD authority; default OFF).
  // Resolved via lib/permissions.ts and read inside the permission chokepoints — never scattered.
  perm_standard_edit_pricing  Boolean   @default(false)
  perm_standard_diary_entries Boolean   @default(false)
  // Diary financial visibility, per role (ADMIN/owner always sees both). see-values = per-block value +
  // "booked" total; see-margin = the margin total (exposes cost structure → tighter defaults).
  perm_manager_see_values     Boolean   @default(true)
  perm_manager_see_margin     Boolean   @default(false) // margin is a DELIBERATE grant, never inherited (ruling 2026-07-12)
  vin_hint_text               String? // tenant-worded "where to find the VIN" for the phone card; empty = no hint (never a marque default)
  perm_standard_see_values    Boolean   @default(false)
  perm_standard_see_margin    Boolean   @default(false)
  // Invoices view (AR/debtors surface, amounts included — the permission is binary by design).
  // Managers/admins always; this extends it to STANDARD.
  perm_standard_view_invoices Boolean   @default(false)
  // ── PHONE-STEP BREAK-GLASS. Set by an OPERATOR when a tenant genuinely cannot complete the step:
  // no mobile at all, a number no carrier will deliver to, or both channels failing. It EXEMPTS the
  // tenant from the gate and writes nothing about a phone — faking phone_verified_at would put a
  // lie in the column SMS 2FA later trusts. Reason mandatory: an exemption with no explanation is
  // indistinguishable from a mistake six months later.
  phone_step_exempt_at        DateTime?

  // ── DEMO TENANTS ──────────────────────────────────────────────────────────────────────────
  // is_demo is the SAFETY flag: it makes sendNotification refuse (lib/demo-tenant), keeps the
  // tenant out of counts and commission, and lets the onboarding gate pass a tenant that has no
  // subscription and never will. It is deliberately NOT derived from demo_expires_at — the sales
  // demo is a demo with no expiry, and conflating the two would either make it immortal-and-live
  // or expiring-and-doomed.
  is_demo                  Boolean   @default(false)
  // WHEN IT DIES. NULL = never (the long-lived sales demo). The purge cron only ever takes rows
  // where this is non-null AND in the past, so a missing expiry can never cause a surprise
  // deletion — it causes an immortal demo instead, which is visible in the Engine Room.
  demo_expires_at          DateTime?
  // The generator's seed. Kept so a demo can be regenerated identically (the sales demo ages and
  // is rebuilt nightly) and so a bug in generated data is reproducible.
  demo_seed                String?
  phone_step_exempt_reason String?
  phone_step_exempt_by     String? // Operator.id — never a tenant user; only we can grant this

  // ── UTILISATION TRAFFIC LIGHT (dashboard capacity panel) ──────────────────────────────────────
  // Percentages, tenant-configurable. red BELOW util_red_below, amber up to util_amber_below, green
  // at or above it. NULLABLE with defaults applied in lib/utilisation-light so a half-configured row
  // cannot produce a half-broken light. The writer refuses red >= amber — an inverted pair leaves no
  // amber band and looks like a working light that isn't.
  util_red_below   Int? @default(50)
  util_amber_below Int? @default(75)

  // ── THE REPORTING ANCHOR ─────────────────────────────────────────────────────────────────────
  // Where this tenant's reporting begins. EVERY dashboard tile clips to it, in one place, before
  // any compute runs — clipping used to be opt-in per tile, and the four that did not opt in put a
  // twelve-month net profit beside a five-month cost base. NOT NULL because "nobody set it" is
  // indistinguishable to a reader from "set to the earliest record", and an invisible window is
  // the whole failure. Backfilled to the earliest record truncated to the month; new tenants
  // default to signup, which for them is the same date. Settings → Company Profile → Financial.
  reporting_start_date DateTime @default(now())

  billing            GroupBilling?
  features           GroupFeature[]
  sites              Site[]
  roles              Role[]
  users              User[]
  customers          Customer[]
  vehicles           Vehicle[]
  vehicle_identities VehicleIdentity[]
  services           ServiceCatalogue[] // Services at Group level (master list)
  parts              PartCatalogue[]
  tax_rates          TaxRate[]
  promos             Promo[]
  payment_methods    PaymentMethod[]
  audit_logs         AuditLog[]
  bookings           Booking[]
  job_cards          JobCard[]
  diary_notes        DiaryNote[]

  // Cost-capture
  cost_people      CostPerson[]
  overheads        Overhead[]
  costs            Cost[]
  cost_allocations CostAllocation[]

  // Invoicing
  invoices         Invoice[]
  invoice_sequence InvoiceSequence?

  // Product catalogue (tenant-level; one shared catalogue across all sites)
  catalogue_items     CatalogueItem[]
  service_tiers       ServiceTier[]
  leaveRecords        LeaveRecord[]
  publicHolidays      PublicHoliday[]
  employmentEvents    EmploymentEvent[]
  siteConfigEvents    SiteConfigEvent[]
  importBatches       ImportBatch[]
  catalogueAliases    CatalogueAlias[]
  lineSplitTemplates  LineSplitTemplate[]
  notifications       NotificationLog[]
  message_threads     MessageThread[]
  // Per-tenant inbound mailbox token. RANDOM AND ROTATABLE — deliberately NOT derived from `ref`
  // (sequentially allocated, so an attacker could enumerate every garage) nor from `id` (unguessable
  // but unrotatable: a leaked address would be unfixable without changing the primary key).
  inbound_token       String?              @unique
  magicLinks          CustomerMagicLink[]
  countryWaitlist     CountryWaitlist[]
  quoteVersions       QuoteVersion[]
  payments            Payment[]
  refunds             Refund[]
  providerConnections ProviderConnection[]
  applicationFeeRates ApplicationFeeRate[]
  smsTopUps           SmsTopUp[]
  commissionRefusals  CommissionRefusal[]
  credit_notes CreditNote[]
  due_items          VehicleDueItem[]
  odometer_readings  VehicleOdometerReading[]
  due_item_answers   DueItemCustomerAnswer[]
  due_item_lines     DueItemLine[]
  tyre_readings      TyreReading[]
  battery_readings   BatteryReading[]
  marketing_contacts MarketingContact[]
  schedule_readings  ServiceScheduleReading[]
}

/**
 * A TENANT'S CONNECTION TO ONE PAYMENT PROVIDER. One row per (group, provider).
 * ── WHY THIS EXISTS RATHER THAN MORE COLUMNS ON Group ───────────────────────────────────────────
 * Stripe alone took eight `stripe_*` columns on Group. Payment Assist and Bumper are next, both
 * per-dealer credentialed, and the same treatment would mean twenty-odd mostly-null columns on the
 * tenant row plus a third bespoke reader. The states a provider can be in are provider-independent
 * — never connected, half set up, live, restricted, revoked — so they belong in one shape that a
 * second provider joins by inserting a row.
 * THE Group.stripe_* COLUMNS ARE NOW VESTIGIAL. They were backfilled into this table and nothing
 * reads or writes them any more (see the comment at their definition). Left in place rather than
 * dropped: a destructive migration buys nothing here, and the columns are the only record of what
 * the pre-migration state was if the backfill ever needs auditing.
 */
/**
 * WHAT GREASEDESK TAKES ON A CARD PAYMENT A GARAGE COLLECTS THROUGH US.
 * Effective-dated, on the CommissionRate model: rates are never edited, only superseded by a new
 * forward row, and Payment.fee_rate_id is a FROZEN link so what was charged stays explicable years
 * later. Amending a rate that has already priced a transaction would silently rewrite history.
 * ── BASIS POINTS, NOT A PERCENT AND NOT A FLOAT ─────────────────────────────────────────────────
 * 25 = 0.25%. An integer over 10000, the same arithmetic lib/commission::splitAmount already uses.
 * A float rate on money is how a rounding argument starts.
 * ── group_id NULL IS THE PLATFORM DEFAULT, AND THAT IS WHY THE UNIQUE IS PARTIAL ────────────────
 * A row with a group_id is that tenant's own negotiated rate; NULL is the default everyone else
 * gets. Postgres treats NULLs as DISTINCT in a unique index, so the obvious
 * @@unique([group_id, country_code, currency, effective_from]) would happily allow TWO platform
 * defaults on the same boundary date and leave the resolver silently picking one. The timeline
 * invariant needs TWO PARTIAL unique indexes, which Prisma cannot express — they are created in
 * raw SQL in the migration and must be preserved by hand if this model is ever rewritten:
 * UNIQUE (country_code, currency, effective_from)           WHERE group_id IS NULL
 * UNIQUE (group_id, country_code, currency, effective_from) WHERE group_id IS NOT NULL
 * (The same NULL-distinctness is what makes ProviderConnection's (provider, external_id) safe —
 * there, many nulls SHOULD coexist. Here exactly one row must win. Same rule, opposite need.)
 * ── VAT, SETTLED 2026-08-15 ─────────────────────────────────────────────────────────────────────
 * The fee is a SEPARATE TAXABLE SUPPLY by GreaseDesk to the garage, standard-rated at 20% once we
 * are registered, and EXCLUSIVE: basis_points is 0.25% PLUS VAT where applicable. 25 is therefore
 * the settled figure and does not become 30.
 * Deliberately unlike the £75 subscription, which is quoted INCLUDING VAT. A round number matters
 * when a garage owner is choosing software; it does not when a fee is a line on a statement. Both
 * are intentional — see lib/application-fee for the full reasoning and the turnover position.
 */
/**
 * ── THE VAT CUT-OVER IS AN EFFECTIVE-DATED QUESTION. DECIDE IT WHILE THERE ARE THREE ROWS. ──────
 * GreaseDesk Ltd is not VAT-registered (garageVatRegistered() reads an unset env var, so false;
 * Stripe Tax and VAT-ID collection are gated on it and are off). No VAT has ever been charged on an
 * application fee: every fee to date is exactly floor(amount × 25 / 10000) with nothing added —
 * 12p, 12p, 6p, of which 12p has been returned. There is no historical VAT to correct.
 *
 * On registration the 25bp becomes a VATable supply, and `applicationFeePennies` will need to know
 * whether a fee was struck BEFORE or AFTER that date. This model already carries the machinery for
 * exactly that: an append-only-forward timeline with a DB-unique constraint, the same shape
 * CommissionRate uses. The cut-over should be a rate row with an effective date, NOT a boolean read
 * at request time — a boolean cannot answer "what was the rule in March".
 *
 * Recording it here because the decision is free today and expensive later: three rows can be
 * reasoned about in one screen, and thirty thousand cannot.
 *
 * COMMERCIAL, NOT TECHNICAL: whether registration RAISES the fee 20% for existing tenants or is
 * absorbed is the owner's call. Terms §6 as published already says the fee is "plus VAT where
 * applicable" and that "if we become VAT-registered, VAT will be added to the fee" — i.e. the
 * published position is already PASS IT ON. Changing that is what would need notice, not keeping it.
 */
model ApplicationFeeRate {
  id           String  @id @default(uuid())
  /**
   * NULL = the platform default. Set = this tenant's own rate, which beats the default REGARDLESS
   * OF DATES — a negotiated rate is not overridden by us changing the default later.
   */
  group_id     String?
  country_code String // ISO-2, the tenant's tax_country_code
  currency     String // ISO-4217, the collected payment's currency

  /**
   * 25 = 0.25%. Integer; fee = floor(amount × bp / 10000).
   */
  basis_points    Int
  /**
   * Present and NULL by design, both of them. A floor is regressive exactly where it hurts (50p on
   * a £36 payment is 1.4%) and gives a garage a reason to steer small jobs to cash, which loses the
   * whole transaction rather than the difference; a cap is not a conversation below roughly a £10k
   * job. Neither is wanted today. They exist because fee_rate_id is frozen, so adding a column
   * afterwards is a migration over money already charged — the same reasoning that put
   * revenue_stream on CommissionRate ahead of need.
   */
  min_fee_pennies Int?
  cap_fee_pennies Int?

  effective_from DateTime
  created_by     String? // operator id (audit)
  created_at     DateTime @default(now())

  group Group? @relation(fields: [group_id], references: [id], onDelete: Cascade)

  // Serves the resolver's lookup. The UNIQUENESS is enforced by the two partial indexes above,
  // created in raw SQL — this plain index is for reads only and guarantees nothing.
  @@index([country_code, currency, effective_from])
  @@index([group_id])
}

/**
 * A PURCHASE OF EXTRA SMS. An append-only record of packs bought, never a balance.
 * ── WHY THERE IS NO `remaining` COLUMN ──────────────────────────────────────────────────────────
 * The same reason Invoice.amount_paid_pennies is a cache of the Payment ledger and not a figure
 * anyone writes: two writers of one number is how a counter and its truth start disagreeing. What
 * has been USED is already recorded — every accepted send is a NotificationLog row — so the balance
 * is derived from purchases minus usage (lib/sms-allowance). A decrement-on-send counter would be a
 * second opinion that drifts the first time a send fails halfway.
 * TOP-UPS DO NOT EXPIRE; the monthly included allowance does. A garage that buys a hundred on the
 * 28th keeps them — they paid for a quantity, not for a month — while the included hundred is part
 * of the subscription and resets with it. See lib/sms-allowance for the arithmetic.
 */
model SmsTopUp {
  id       String @id @default(uuid())
  group_id String

  /**
   * How many messages this pack added. Always positive; a correction is a new row, never an edit.
   */
  quantity       Int
  /**
   * What the garage paid, for the record. NULL for a pack granted rather than sold (goodwill, support).
   */
  amount_pennies Int?
  /**
   * Stripe payment/invoice reference when it was sold. NULL when granted.
   */
  source_ref     String? @unique
  /**
   * Who granted it, when it was not a purchase. NULL = bought by the tenant.
   */
  granted_by     String?
  note           String?

  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id, created_at])
}

model ProviderConnection {
  id       String @id @default(uuid())
  group_id String
  /**
   * 'stripe' | 'payment_assist' | 'bumper'. A STRING, not an enum, for the same reason
   * Payment.provider is: adding a processor should be a row, not a migration.
   */
  provider String

  /**
   * The provider's own identifier for this connection — `acct_…` for Stripe, a dealer id for the
   * others. NULL while a connection is being set up, and NULL forever for a provider that has no
   * such concept. Unique per provider so one account cannot be claimed by two tenants; Postgres
   * treats NULLs as distinct, so the many unconnected tenants don't collide.
   */
  external_id String?
  /**
   * Real money or a sandbox, from the provider's own object — never inferred from a key prefix.
   * NULL = unknown. See Group.stripe_account_livemode for why that distinction is load-bearing.
   */
  livemode    Boolean?

  /**
   * Can the garage take money through this provider right now? The provider's answer, mirrored.
   */
  charges_enabled  Boolean @default(false)
  /**
   * Can the provider pay the garage out? Separate: Stripe routinely enables one without the other.
   */
  payouts_enabled  Boolean @default(false)
  /**
   * The provider's own reason string, stored VERBATIM. Paraphrasing is how a product ends up telling
   * a garage something the provider's own dashboard contradicts.
   */
  disabled_reason  String?
  /**
   * What the provider says is outstanding, so the product can name it rather than leave them guessing.
   */
  requirements_due Json?
  /**
   * WHAT THIS ACCOUNT CAN ACTUALLY TAKE — Stripe's `capabilities` map, verbatim
   * ({ card_payments: 'active', link_payments: 'inactive', … }). Mirrored so the invoice can show
   * payment marks the garage really has rather than a fixed set we hope is true: a document
   * promising Klarna to a customer whose garage cannot take it is worse than promising nothing.
   * Only 'active' counts — 'pending' is a capability Stripe has not granted yet.
   * NULL = never synced. Written by the one writer (lib/stripe-connect::applyAccount), which
   * already receives the whole Account object, so this costs no extra call.
   */
  capabilities     Json?

  /**
   * When the connection came into existence — NOT when it became able to trade.
   */
  connected_at    DateTime?
  /**
   * The garage revoked us at the provider's end. Kept after external_id is cleared, so the product
   * can say "this was switched off" instead of silently reverting to "never connected".
   */
  disconnected_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, provider])
  @@unique([provider, external_id])
  @@index([provider])
}

// Upload failure TELEMETRY (2026-07-14): the technical black-box recorder for the outbox drain —
// {step, status, code, body} for a failed photo/video upload. DELIBERATELY separate from AuditLog:
// the audit trail is the card's BUSINESS record (invoice raised, marked paid, work started) and the
// future Car Owner product surfaces it — a WebKit stack trace has no place there. Nothing technical
// in the ledger, ever. Joined to the card for diagnosis; never rendered to a customer.
model UploadTelemetry {
  id          String   @id @default(uuid())
  group_id    String
  job_card_id String
  photo_id    String
  kind        String
  step        String
  status      Int      @default(0)
  code        String?
  body        String?
  attempts    Int      @default(0)
  created_at  DateTime @default(now())

  @@index([job_card_id, created_at])
  @@index([group_id, created_at])
}

// PLATFORM OPERATOR allowlist (SuperAdmin portal). A user id here can reach /superadmin — this is
// entirely SEPARATE from UserRole (a tenant's ADMIN is NOT an operator; no tenant-role change can
// ever grant this). Resolved only via lib/superadmin::requireSuperAdmin, never getVisibility.
model PlatformOperator {
  user_id    String   @id
  note       String?
  created_at DateTime @default(now())
}

// ── PLATFORM-TIER ACTOR IDENTITIES (layer 1). Operators and Reps are their OWN authenticated
// classes — NOT tenant Users. A rep belongs to no garage; an operator's authority is a different
// axis from tenant authority. Each has its own credentials and its own NextAuth provider; the JWT
// carries actorClass to keep the three boundaries separate. See lib/operator-auth / lib/rep-auth.
enum OperatorRole {
  owner // all ops; manages operators; ONLY role that purges or transfers ownership
  country_manager // region-scoped; all support + lifecycle except operator-management and purge
  support // region-scoped, read-only tenant visibility + password reset / change email / extend trial
}

model Operator {
  id                   String       @id @default(uuid())
  email                String       @unique
  passwordHash         String
  name                 String
  role                 OperatorRole @default(support)
  // ISO-3166-1 alpha-2 country codes this operator may act in. IGNORED for `owner` (all regions).
  // The ONLY source of region scope — operatorTenantScope() derives the query filter from here,
  // never from a request param. Empty for a non-owner = can see nothing (fails closed).
  regions              String[]     @default([])
  status               String       @default("active") // 'active' | 'suspended' (authorize() blocks non-active)
  suspended_at         DateTime?
  note                 String?
  // Set-password invite (mirrors the tenant User flow): raw token emailed, only its hash stored,
  // single-use, 5-day expiry. A new operator is created INVITE_PENDING and cannot log in until set.
  invite_token_hash    String?
  invite_token_expires DateTime?
  invite_token_used_at DateTime?
  last_login_at        DateTime? // stamped by the operator authorize() on successful sign-in
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
}

model Rep {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  ref_code       String   @unique // the `?ref=<code>` marketing token that attributes a signup
  country_code   String   @default("GB")
  payout_details Json?
  status         String   @default("active") // 'active' | 'suspended'
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

// ── COMMISSION ENGINE (layer 2). The money spine: ONE calculation (lib/commission) every surface
// reads. Built entirely dormant (no live payments); every rule is proven synthetically against a
// fixed clock. See lib/commission for the invariants; the fixed-clock plan is the spec.

// Effective-dated rate table. A rate at time T = the LATEST row for (country,currency,tier) with
// effective_from ≤ T (the EmploymentEvent "value-at-T" rule). An amendment is a NEW forward row;
// existing rows are NEVER updated, so historical commission is frozen at the rate in force when the
// payment was collected. Amendable by Platform Owner in the SAP.
model CommissionRate {
  id             String   @id @default(uuid())
  country_code   String // ISO-2 (the tenant's tax_country_code)
  currency       String // ISO-4217 (the collected payment's currency)
  tier           String // 'first_12m' | 'thereafter'
  /**
   * WHICH REVENUE THIS RATE PRICES. 'subscription' today — the £75/month a tenant pays us — and
   * nothing else exists yet. Added ahead of need (2026-08-13) purely so it CAN exist: application
   * fees on garage card takings would be a second, differently-shaped stream (a share of a variable
   * amount per transaction, not a flat sum per collected month), and CommissionEntry.rate_id is a
   * FROZEN link to the rate applied. Adding this column after a year of live entries would be a
   * migration over frozen money; adding it now, defaulted, costs nothing and changes nothing.
   * THIS IS NOT A DECISION TO PAY REPS ON TRANSACTION REVENUE. It is the column that keeps the
   * question answerable later.
   */
  revenue_stream String   @default("subscription")
  effective_from DateTime
  amount_pennies Int // flat commission per collected month at this tier, in `currency`
  created_by     String? // operator id (audit)
  created_at     DateTime @default(now())

  // THE TIMELINE INVARIANT, at the database. For a (country, currency, tier) the effective-dated
  // rows form a step function; the engine reads "latest effective_from ≤ collected_at". Two rows
  // sharing an effective_from would make that lookup ambiguous (which rate wins on the boundary
  // day?) — so the boundary point must be unique. This UNIQUE index is that rule made physical:
  // a clean, non-overlapping timeline per key. It also serves the engine's resolveRate lookup
  // (same leading columns), so it replaces the old non-unique index rather than adding to it.
  // The timeline is per STREAM as well as per key: a transaction-fee rate must not collide with, or
  // be mistaken for, a subscription rate on the same date.
  @@unique([revenue_stream, country_code, currency, tier, effective_from])
}

// A JOIN, not a field on the tenant — a garage can attribute to a rep AND a regional manager at
// once, share_bp splitting one payment's commission (active shares sum to 10000). Effective-dated +
// ended_at so a territory hand-over applies the right split per period.
model TenantAttribution {
  id             String    @id @default(uuid())
  group_id       String
  party_type     String // 'rep' | 'operator'
  party_id       String
  role           String // 'referrer' | 'regional'
  share_bp       Int
  effective_from DateTime
  ended_at       DateTime? // null = active; a hand-over sets this (exclusive) as the next takes over (inclusive)
  source         String // 'ref_param' | 'manual' | 'import'
  created_by     String?
  created_at     DateTime  @default(now())

  @@index([group_id])
  @@index([party_type, party_id])
}

// The MATERIALISED ledger — written by the accrual/clawback path on Stripe paid/refund events. Every
// row freezes rate_id + share_bp + tier + currency, so a recompute cross-checks and never moves.
// Idempotency: source_ref = the payment ref (accrual) or refund ref (clawback); unique per party+kind.
/**
 * A COMMISSION ACCRUAL THAT DID NOT HAPPEN, AND WHY.
 * The engine refuses rather than inventing a figure — no rate, shares that do not sum to 10000, a
 * tenant it cannot load. lib/commission-billing catches that refusal deliberately, because wedging
 * Stripe into infinite retry over OUR config error helps nobody. Until now the entire trace was a
 * console.error: a rep quietly earned nothing and the only witness was a log line in Vercel.
 * This is that witness, kept. It is the ABSENCE of money, recorded — deliberately NOT a
 * CommissionEntry, because an entry is a sum and every reader of the ledger adds them up; a
 * zero-value "refused" entry would be an accrual of nothing rather than a refusal to accrue.
 * OPERATOR-ONLY, and that is why it is not an AuditLog row: AuditLog is the TENANT's trail and a
 * garage can read theirs. What we pay a rep for their signup is not the garage's business.
 * `resolved_at` is set when a later accrual for the same payment succeeds — so the board shows what
 * is still outstanding rather than a growing pile of history. Nothing is ever deleted.
 */
model CommissionRefusal {
  id          String    @id @default(uuid())
  group_id    String
  source_ref  String // the payment ref the accrual was for
  code        String // lib/commission COMMISSION_ERROR.* — the typed code, never the prose
  message     String // the prose, for a human reading this at two in the morning
  detail      Json? // structured grain from CommissionError.detail (country, currency, tier, …)
  occurred_at DateTime  @default(now())
  resolved_at DateTime? // a later accrual for the same payment succeeded

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, source_ref, code]) // a re-delivered webhook records once, not once per retry
  @@index([resolved_at])
  @@index([group_id])
}

model CommissionEntry {
  id             String   @id @default(uuid())
  group_id       String
  party_type     String
  party_id       String
  period         String // 'YYYY-MM' — accrual: the payment's month; clawback: the refund's month
  kind           String // 'accrual' | 'clawback'
  tier           String
  /**
   * Which revenue produced this entry — see CommissionRate.revenue_stream. 'subscription' today.
   */
  revenue_stream String   @default("subscription")
  rate_id        String // FROZEN link to the CommissionRate applied
  share_bp       Int
  amount_pennies Int // + accrual, − clawback
  currency       String
  source_ref     String // idempotency key: payment ref (accrual) or refund ref (clawback)
  payment_ref    String // the collected payment this relates to (accrual: itself; clawback: the refunded payment) — netting key
  status         String   @default("pending") // 'pending' | 'paid' | 'void'
  payout_id      String? // set when a payout run pays it; a paid accrual is never mutated by a later clawback
  created_at     DateTime @default(now())

  @@unique([source_ref, party_id, kind]) // a re-delivered webhook is a no-op
  @@index([group_id, period])
  @@index([party_id, status])
  @@index([payment_ref])
}

// PLATFORM audit trail for operator actions (archive/purge). DELIBERATELY its own table, NOT
// AuditLog: AuditLog is group-scoped and cascade-deleted with the tenant, so a purge record can't
// live in the tenant it destroys. This survives the purge — target_name/ref are SNAPSHOTS.
// PLATFORM-TIER wizard step definitions (ruling 2026-07-29): the OPERATOR edits wording, order,
// required/enabled and country scope in the Engine Room; what a step WRITES is code — handler_key
// binds to the fixed registry in lib/setup-wizard (unknown/retired key = step does not render,
// fail-closed + logged). Seeded with the six launch steps; latest-wins editing, SuperAdminAudit'd.
model SetupStepDef {
  id          String   @id @default(uuid())
  step_key    String   @unique // stable identity for audit/ordering ties
  handler_key String // registry binding — NOT operator-editable
  title       String
  body        String   @default("")
  help_text   String   @default("")
  position    Int
  required    Boolean  @default(false)
  enabled     Boolean  @default(true)
  countries   Json? // ISO-3166 array; NULL = all countries. Most-specific per handler_key wins.
  updated_at  DateTime @default(now()) @updatedAt
}

model SuperAdminAudit {
  id                   String   @id @default(uuid())
  operator_user_id     String // the ACTING operator's id
  action               String // 'tenant.archived|unarchived|purged' | 'operator.created|role_changed|regions_changed|suspended|unsuspended'
  // EXTENDED for operator-target actions (this table was tenant-target only). One of target_group_id
  // (tenant actions) or target_operator_id (operator-management actions) is set; the other is null.
  target_group_id      String? // now NULLABLE
  target_operator_id   String? // the operator acted upon
  target_name_snapshot String // tenant name OR operator email — survives even if the row is later changed
  target_ref_snapshot  String?
  reason               String? // required on suspend; free-text where an action takes one
  detail               Json? // before/after (role/regions), purge counts, etc.
  created_at           DateTime @default(now())

  @@index([created_at])
  @@index([target_group_id])
  @@index([target_operator_id])
}

// ── TWO-FACTOR (TOTP). Generic store keyed by (subject_type, subject_id) — deliberately NOT FK'd to
// one identity table, so the SAME mechanism extends to tenant Users and Reps later with NO schema
// change (just a new subject_type). Wired to operators ONLY in this slice. lib/two-factor is the sole
// reader/writer; the TOTP crypto is lib/totp. The secret is a shared secret (base32) stored as-is —
// a DB leak yields the secret but not the password (bcrypt), so 2FA still holds unless BOTH leak;
// encryption-at-rest of the secret is a noted hardening follow-up.
model TwoFactorSecret {
  id                  String    @id @default(uuid())
  subject_type        String // 'operator' | 'tenant' | 'rep'
  subject_id          String
  // WHICH second factor this row describes. 'totp' has a secret and no phone; 'sms' has a phone and
  // no secret. One row per subject either way, so the lifecycle (enabled flips only after a live
  // code round-trips) is identical for both and cannot fork.
  method              String    @default("totp") // 'totp' | 'sms'
  secret              String? // base32 TOTP secret — NULL on an sms-method row
  // THE VERIFIED NUMBER, and deliberately NOT User.phone. That column is a free-text HR profile
  // field an ADMIN can edit, so a factor delivered there would let an admin redirect a colleague's
  // codes to their own handset. Only a verification round-trip writes this one.
  // Stored E.164 digits-only via lib/contact-routes::toE164Digits — the same normaliser the customer
  // spine uses. No raw copy: a customer's raw number is what the garage recognises on screen; this
  // one is only ever dialled by a machine.
  phone_e164          String?
  // TWO TIMESTAMPS, TWO DIFFERENT CLAIMS, and conflating them would quietly weaken a second factor.
  //   phone_verified_at — an SMS code was confirmed. A HANDSET was proven. This is the only value
  //                       SMS 2FA may ever build on, so it must never be written by any other route.
  //   phone_recorded_at — a code was confirmed by SOME channel (sms or email). Enough to say "we
  //                       hold a number this person can be reached at", which is what the signup
  //                       gate actually needs, and all an email fallback can honestly assert.
  // SMS sets both; email sets only the second.
  phone_verified_at   DateTime?
  phone_recorded_at   DateTime?
  phone_confirmed_via String? // 'sms' | 'email' — legibility; derivable, but not at a glance
  enabled             Boolean   @default(false) // false during enrolment; true ONLY after a confirming code round-trips
  confirmed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@unique([subject_type, subject_id])
}

// One-time recovery codes — the escape hatch when the authenticator device is lost. Raw shown ONCE at
// enrolment; only the sha256 hash is stored (like invite/reset tokens). used_at makes each single-use.
/**
 * ONE-TIME CODES WE DELIVERED, for every purpose. Deliberately one table, not one per feature: a
 * signup phone verification and an SMS login code are the same mechanism asked twice, and a second
 * table would mean a second expiry rule, a second attempt cap and eventually a second bug.
 * `purpose` is what keeps them apart — a code minted to verify a phone can never satisfy a login,
 * because the lookup is scoped to it. Only the HASH is stored, so a database reader cannot sign in
 * as anybody. `consumed_at` makes a code single-use; `attempts` kills THIS code after 5 wrong
 * guesses, which is the delivered-code analogue of the rotating-TOTP lockout in lib/two-factor —
 * both exist, because they answer different questions.
 */
model DeliveredCode {
  id           String    @id @default(uuid())
  subject_type String // 'tenant' | 'operator' | 'rep' — same Subject shape as TwoFactorSecret
  subject_id   String
  purpose      String // 'phone_verify' | 'login_2fa'
  destination  String // E.164 digits, exactly as sent — the record of WHERE it went
  // HOW it went: 'sms' | 'email'. Written at issue, read at verify, NEVER taken from the client —
  // it decides whether confirming the code may set phone_verified_at (a handset answered) or only
  // phone_recorded_at. NULL on rows minted before the email fallback existed, and every one of
  // those was an SMS, so a NULL reads as 'sms'.
  channel      String?
  code_hash    String // sha256(code). NEVER the code.
  expires_at   DateTime
  attempts     Int       @default(0)
  consumed_at  DateTime?
  created_at   DateTime  @default(now())

  @@index([subject_type, subject_id, purpose])
  @@index([expires_at])
}

model TwoFactorRecoveryCode {
  id           String    @id @default(uuid())
  subject_type String
  subject_id   String
  code_hash    String // sha256(raw recovery code)
  used_at      DateTime? // set when consumed at login — a used code can never be reused
  created_at   DateTime  @default(now())

  @@index([subject_type, subject_id])
}

// Webhook idempotency ledger (item-12): every Stripe event.id is recorded ONCE before its effect
// is applied; a replay finds the row and is skipped. "A replayed queue that double-logs an hour is
// bad; a replayed charge is worse" — the outbox discipline, higher stakes.
model StripeEvent {
  event_id     String   @id // Stripe event.id — the natural idempotency key
  type         String
  /**
   * WAS THIS REAL MONEY? Straight from event.livemode, never inferred.
   * Mode used to be worked out from an `sk_live_` key prefix, which a RESTRICTED live key
   * (`rk_live_…`) fails — so the platform reported "test" about a live account whose objects
   * returned livemode:true, and that wrong answer then outlived the code, got written into notes,
   * and was repeated as fact. Every Stripe object carries its own livemode; recording it here makes
   * the question answerable from data instead of from an API call or somebody's memory.
   * NULLABLE: rows written before this column genuinely don't know, and 'false' would be a claim
   * that they were test events. Unknown, not test.
   */
  livemode     Boolean?
  processed_at DateTime @default(now())
}

// Versioned, auditable record of a cookie-consent choice — because a regulator or user may later ask
// "what did they consent to, and when". Anonymous (pre-login, public site): no PII, just the browser's
// stable consent_id (also carried in the gd_consent cookie), the policy version + region in force, and
// the per-category choice. A changed choice writes a NEW row with the same consent_id → the trail is
// the history. Same discipline as the operator audit / rep agreement.
// Inbound-webhook dedupe ledger. Same shape and same discipline as StripeEvent: the id is written
// FIRST, so a replay collides on insert and is acknowledged without being processed twice.
// Keyed on the SVIX DELIVERY ID, never on the payload's `message_id` — that field is the sender's
// own RFC header and is therefore attacker-controlled; deduping on it would let anyone suppress a
// genuine inbound message by pre-sending one that claims the same header.
model InboundEvent {
  svix_id      String   @id
  type         String
  email_id     String?
  processed_at DateTime @default(now())
}

model ConsentEvent {
  id             String   @id @default(uuid())
  consent_id     String // the browser's stable consent uuid (mirrors the gd_consent cookie)
  policy_version String
  region         String
  functional     Boolean
  analytics      Boolean
  marketing      Boolean
  created_at     DateTime @default(now())

  @@index([consent_id])
  @@index([created_at])
}

// THE Content system — one table, two behaviours, legal-grade versioning + a country axis. `legal`
// documents FREEZE an immutable version at publish (acceptance/consent records reference a specific
// version, so a version someone agreed to must never change underneath them — the CommissionRate freeze
// discipline). `page` documents let the LATEST published version win; priors are kept only for undo.
// The types differ by RULE at publish time, not by architecture: history never moves for either — you
// never mutate a published row, you publish a NEW version. Keyed on (slug, country, version): the same
// slug can have GB and IE variants; resolution is exact-country → GB fallback, latest published_at wins.
// `version` is a STRING stamp (e.g. '2026-07-21') so an existing consent record resolves to a real
// version; the sentinel 'draft' marks the single work-in-progress row (the unique index enforces one
// draft per slug+country). Body is markdown, rendered SAFELY (no raw HTML). Media/scheduling/SEO later.
model Document {
  id             String    @id @default(uuid())
  slug           String
  title          String
  type           String // 'legal' | 'page'
  country_code   String    @default("GB")
  body           String // markdown
  version        String // published: a stamp like '2026-07-21'; WIP draft: the sentinel 'draft'
  status         String    @default("draft") // 'draft' | 'published'
  effective_from DateTime?
  published_at   DateTime?
  created_by     String? // operator id
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([slug, country_code, version])
  @@index([slug, country_code, status])
}

// Navigation management for the marketing site — footer + main-nav links defined in the Content system
// instead of hardcoded in SiteChrome, so a legal/marketing document can be linked without a code change.
// A link points at an internal DOCUMENT (by slug → /slug), an internal ROUTE (a path), or an EXTERNAL
// URL. Ordered, region-shaped (country_code, like documents), toggleable. Owner + Country Manager manage.
model NavLink {
  id           String   @id @default(uuid())
  placement    String // 'footer' | 'main'
  label        String
  kind         String // 'document' | 'route' | 'external'
  target       String // document slug | internal path (/pricing) | external URL (https://…)
  sort_order   Int      @default(0)
  country_code String   @default("GB")
  enabled      Boolean  @default(true)
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([placement, country_code, sort_order])
}

model GroupBilling {
  id               String        @id @default(uuid())
  group_id         String        @unique
  plan_name        String
  status           BillingStatus
  retention_months Int
  included_sites   Int
  active_sites_cnt Int           @default(1)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now())

  // ── Stripe CACHE (item-12). Stripe is the source of truth; these four are a mirror written ONLY
  // by verified webhook handlers (lib/stripe-webhook). subscription_status is the raw Stripe status
  // (trialing/active/past_due/canceled/…) that lib/billing derives the gate + the display status
  // from. NULL until the tenant completes Checkout. Never write these from a redirect. ──
  stripe_customer_id     String?   @unique
  stripe_subscription_id String?   @unique
  subscription_status    String? // raw Stripe subscription.status
  current_period_end     DateTime? // Stripe's period end (renewal/charge date), webhook-maintained

  // ── THE GRACE CLOCK. Written ONCE, when the tenant first enters a grace-worthy state, and never
  // overwritten while non-null — otherwise every Stripe retry would reset the countdown and the
  // tenant would never restrict. The END is DERIVED (anchor + GRACE_DAYS) in lib/billing, never
  // stored, so changing the window is a constant and not a migration.
  //
  // DELIBERATELY NOT current_period_end: Stripe ADVANCES that on retry, so a countdown keyed to it
  // silently extends itself while the tenant sits unpaid — the exact failure this replaces.
  //
  // The reason is carried because the two populations need different words for the same rule: a
  // trial that ended never intended to pay; a past_due subscription is a customer whose card
  // stopped working. Telling a two-year customer their trial ended would be insulting.
  grace_started_at DateTime?
  grace_reason     String? // 'trial_ended' | 'payment_failed'

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

// PER-TENANT MODULE ENTITLEMENT (slice-1 C). Read ONLY through lib/modules::hasModule — never an
// inline query, same discipline as lib/billing::canWrite.
//
// STRIPE IS THE SOURCE OF TRUTH; these rows are a DERIVED CACHE, exactly as subscription_status is.
// The single writer (lib/stripe-billing-cache::applyStripeSubscriptionToCache) derives the module
// set from the subscription's Price IDs and writes billing status AND modules together, from the
// same subscription object, in one transaction. Two facts written by one writer from one source
// cannot drift — which is the whole point: a tenant must never pay for Booking and not have it.
//
// `source` records WHY a module is on, so an override is visible rather than indistinguishable from
// something paid for:
//   stripe  — derived from a subscription line item (the normal case)
//   grant   — an explicit operator override (comped, beta, migration); survives Stripe sync
//   default — seeded open before modules were sold; every pre-existing tenant
enum FeatureSource {
  stripe
  grant
  default
}

model GroupFeature {
  id          String        @id @default(uuid())
  group_id    String
  feature_key String
  enabled     Boolean       @default(false)
  source      FeatureSource @default(stripe)
  updated_at  DateTime      @default(now()) @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, feature_key])
}

model Site {
  id             String   @id @default(uuid())
  group_id       String
  site_name      String
  trading_name   String?
  company_number String?
  vat_number     String?
  address        String?
  // US-only structured subdivision (USPS code, e.g. 'AL'). Captured at the onboarding site step for
  // countries whose profile sets stateField; drives timezone derivation (lib/us-states) and is the
  // future sales-tax jurisdiction hook. NULL for non-US tenants and pre-existing rows (honest-null).
  state_code     String?
  phone          String?
  whatsapp       String? // site WhatsApp, stored as E.164 DIGITS; independent of phone (see Group.whatsapp)
  email          String?
  timezone       String   @default("Europe/London")
  currency_code  String   @default("GBP")
  locale         String   @default("en-GB")
  is_franchise   Boolean  @default(false)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  // --- NEW CONFIGURATION FIELDS ---
  pricing_display_mode String @default("ex_vat") // Ex VAT/Inc VAT display
  supported_countries  Json?
  supported_currencies Json? // UNUSED (2026-07-23): the Financial multi-select was removed — nothing read this; it implied multi-currency invoicing that doesn't exist. Column kept to avoid a migration; do not add readers.
  // --- DIARY DISPLAY (per-site) ---
  open_days            Int[]  @default([1, 2, 3, 4, 5, 6]) // weekdays open (0=Sun..6=Sat); default Mon–Sat
  open_hour            Int    @default(8) // diary window start hour
  close_hour           Int    @default(18) // diary window end hour
  week_start           Int    @default(1) // first day of week (0=Sun, 1=Mon)
  // Booking-form duration granularity (minutes) for the Quote-tab slot picker. Sub-day durations step
  // by this; working-day length comes from open_hour/close_hour. Default 30. Diary reads start_at/end_at.
  booking_slot_minutes Int    @default(30)
  // Non-working bands (lunch etc.) as [{start,end}] minutes-from-midnight. NULL/[] = none = current
  // behaviour. The footprint skips these; the diary draws them. Read via lib/occupancy parseBreaks.
  breaks               Json?
  // --------------------------------

  group            Group              @relation(fields: [group_id], references: [id], onDelete: Cascade)
  features         SiteFeature[]
  profit_centres   ProfitCentre[]
  resources        Resource[]
  users            User[]
  user_assignments UserSite[]
  customers        Customer[]
  bookings         Booking[]
  job_cards        JobCard[]
  services         ServiceCatalogue[]
  diary_notes      DiaryNote[]
  cost_allocations CostAllocation[]
  invoices         Invoice[]
  leaveRecords     LeaveRecord[]
  publicHolidays   PublicHoliday[]
  config_events    SiteConfigEvent[]
  import_batches   ImportBatch[]

  @@index([group_id])

  // ── INTAKE PROMPTS (per SITE, default OFF) ────────────────────────────────────────────────────
  // PROMPT, never require: the mechanic is asked, and may proceed regardless. A hard gate gets
  // worked around and the data ends up looking captured when it isn't. Named `prompt` rather than
  // `require` so the next reader cannot mistake them for gates.
  // Per SITE because the scanner is a physical object one site owns, and a multi-site group will
  // not have the same kit everywhere. Read at RENDER — never stamped onto a card — so switching one
  // on mid-job starts prompting, and switching it off stops it generating anything.
  intake_prompt_findings   Boolean @default(false)
  intake_prompt_mileage_vin Boolean @default(false)
  intake_prompt_walkaround Boolean @default(false)
  intake_prompt_diag_scan  Boolean @default(false)
  /// The level is not stored here — see the migration. This switch only decides whether a mechanic
  /// is ASKED, like the four above it.
  intake_prompt_oil_level  Boolean @default(false)

  /// "No thanks" to the offer on the Intake tab. A SITE FACT, deliberately, not a browser
  /// dismissal: a prompt that comes back on the next device teaches people that dismissing things
  /// here does not work, and that lesson spreads to every dismissal we ever ship.
  ///
  /// Never cleared. Enabling prompts and then disabling them all again is a NEW decision and the
  /// offer stays gone — Settings is where that decision lives and can be revisited.
  intake_offer_dismissed_at DateTime?
  intake_offer_dismissed_by String?
}

model SiteFeature {
  id          String  @id @default(uuid())
  site_id     String
  feature_key String
  enabled     Boolean @default(false)

  site Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@unique([site_id, feature_key])
}

model ProfitCentre {
  id         String                @id @default(uuid())
  site_id    String
  name       String
  type       String? // legacy free-text; superseded by `category` (kept for non-destructive add)
  category   ProfitCentreCategory? // typed business unit (nullable so the add is non-destructive)
  is_active  Boolean               @default(true)
  created_at DateTime              @default(now())

  site      Site      @relation(fields: [site_id], references: [id], onDelete: Cascade)
  job_cards JobCard[]
  bookings  Booking[]

  @@index([site_id])
}

model Resource {
  id            String       @id @default(uuid())
  site_id       String // belongs to a Site (Location); operational tree is Group → Site → Resource
  name          String // e.g. "Lift 2"
  type          ResourceType // lift / mot_bay / spray_booth
  display_order Int          @default(0) // diary column ordering
  colour        String? // curated palette hex (e.g. "#3B82F6"); null → default neutral
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now())

  site        Site        @relation(fields: [site_id], references: [id], onDelete: Cascade)
  job_cards   JobCard[]
  diary_notes DiaryNote[]

  @@index([site_id])
}

// Many-to-many: which Site(s) a User is assigned to. Assignment only (no roles/enforcement yet).
// User.site_id remains the user's single active/default site; this is the broader assignment set.
model UserSite {
  user_id String
  site_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  site Site @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@id([user_id, site_id])
  @@index([site_id])
}

model Role {
  id          String  @id @default(uuid())
  group_id    String
  name        String
  description String?
  permissions Json    @default("{}")

  group Group  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  users User[]

  @@index([group_id])
}

// ───────────────────────────────────────────────────────────────────────────────
// Identity
// ───────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(STANDARD)

  // --- FIXED GREASEDESK FIELDS ---
  /// NULL = no tenant. NOT REACHABLE by any current writer — registration creates the Group first
  /// and the User second, in the same transaction, and all four user.create sites pass group_id
  /// (0 of 13 rows are null). The old comment here said "optional at creation time; enforced in
  /// app layer" and described a window that does not exist.
  ///
  /// Kept nullable for two reasons. PrismaAdapter is wired in [...nextauth]; the only provider is
  /// Credentials, which does not create users through it — but add an OAuth provider and NextAuth
  /// will insert tenantless User rows itself. And: the nullable column is what lets us test the
  /// guard that exists because of it — counter-payment-gate proves requireTenantApi refuses an
  /// AUTHENTICATED groupless session, and that fixture cannot be built without it.
  group_id        String?
  site_id         String?
  primary_site_id String? // admin-set landing/default site (must be one of the user's assigned sites)
  role_id         String?
  is_active       Boolean  @default(true)
  is_owner        Boolean  @default(false) // immutable: marks the one primary-subscriber per group
  // Per-user grant (ADMIN-set, off by default): a trusted STANDARD mechanic may RAISE an invoice
  // (in_progress→invoiced) at an assigned site, without being promoted to SITE_MANAGER. Grants ONLY
  // the issue transition + retail price visibility — NOT mark-paid, NOT unlock (ADMIN), NOT margin.
  can_invoice     Boolean  @default(false)
  created_at      DateTime @default(now())

  // --- INVITE / SET-PASSWORD TOKEN (single-use; SHA-256 of a high-entropy random token) ---
  invite_token_hash    String?
  invite_token_expires DateTime?
  invite_token_used_at DateTime?

  // --- PASSWORD RESET TOKEN — DELIBERATELY SEPARATE from the invite token (ruling 2026-07-18).
  // Different semantics: an invite is single-use-and-dead; a reset is legitimately REPEATABLE.
  // Reusing invite_* would inherit its "already been used" messaging and the 409-on-existing-email
  // behaviour. 1-hour expiry; consumed (nulled) on a successful reset; only the SHA-256 is stored.
  reset_token_hash    String?
  reset_token_expires DateTime?
  // Session revocation floor. The auth strategy is JWT (self-contained, NOT revocable by deleting
  // rows — the Session table is vestigial under strategy:'jwt'), so a stolen 90-day cookie would
  // otherwise outlive a password reset. Set to now() on reset, on a password change, on an ADMIN
  // "sign out all devices", and on deactivation. The jwt callback kills any token whose `authAt`
  // (our own stamp — NextAuth's `iat` is not reliably exposed there) predates it.
  // THE one place a session is invalidated server-side.
  sessions_valid_from DateTime?

  // Deactivation timestamp. SPLITS THE TWO MEANINGS of is_active=false, which otherwise conflates
  // "invited, never accepted" with "suspended by an admin" — the roster's badge reads the first and
  // would mislabel the second. is_active stays THE enforcement flag (login checks it, nothing else
  // changes); this column only says WHICH kind of inactive, and when. Null + inactive = pending
  // invite; set + inactive = deactivated. WHO did it lives in the audit trail, not here.
  deactivated_at DateTime?

  // --- PROFILE FIELDS (all optional; name + email above are the existing identity fields) ---
  job_title                  String?
  start_date                 DateTime? @db.Date
  phone                      String?
  address                    String?
  driving_licence_categories String?
  next_of_kin_name           String?
  next_of_kin_relationship   String?
  next_of_kin_phone          String?
  emergency_note             String? // voluntary safety note — visible to admin/owner + the user only
  certifications             String?
  working_hours              String?

  // +++ CUSTOMER PORTAL LINK ---
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // --- RELATIONS ---
  group            Group?         @relation(fields: [group_id], references: [id], onDelete: SetNull)
  site             Site?          @relation(fields: [site_id], references: [id], onDelete: SetNull)
  staffRole        Role?          @relation(fields: [role_id], references: [id], onDelete: Restrict)
  site_assignments UserSite[]
  job_cards        JobCard[]      @relation("JobCardMechanic")
  audit_logs       AuditLog[]
  job_card_photos  JobCardPhoto[] @relation("JobCardPhotoUploader")
  cost_person      CostPerson? // optional future link — costs ≠ logins

  // --- NEXTAUTH ---
  accounts Account[]
  sessions Session[]

  @@index([group_id])
  @@index([site_id])
  @@index([role_id])
}

model Customer {
  id                 String    @id @default(uuid())
  group_id           String
  // ORIGIN site, not ownership. A customer belongs to the GARAGE (group_id above), not to a bay —
  // so this is NULLABLE + SetNull, mirroring User.site_id. Previously it was required + Cascade,
  // which meant deleting a Location would have destroyed its customers AND their VehicleOwnership
  // edges (which cascade from Customer) — the spine of the car-first model. Only the application-
  // level delete guard stood in the way; invoices had DB-level protection and customers did not.
  // Null = the origin site is gone; the customer survives as a group-level record.
  site_id            String?
  name               String
  // TWO COLUMNS, ONE NUMBER. `phone` stays the OPERATOR'S RAW INPUT, exactly as typed — it is what
  // the garage recognises on the screen and every display reads it unchanged. `phone_e164` is the
  // machine-dialable form, derived on write by lib/contact-routes::toE164Digits using the TENANT'S
  // COUNTRY PROFILE dial code (never a guess from the string alone).
  // HONEST-NULL: an unparseable number leaves phone_e164 NULL while phone keeps the raw string —
  // unknown, not absent. Normalising in place would be unrecoverable for a mistyped number, so the
  // raw is never overwritten. Digits-only, no leading '+', matching what toE164Digits returns.
  phone              String?
  phone_e164         String?
  email              String?
  address            String? // billing address — source for Invoice.customer_address_snapshot
  notes              String?
  // ── ON ACCOUNT, AND THE TERMS, AS ONE FACT ──────────────────────────────────────────────────────
  // NULL = a retail customer who pays on collection, which is every customer that existed before
  // this column and the overwhelming majority after it. Non-null = an account customer, and the
  // value IS the terms in days (30 for the usual "30 days net").
  //
  // Deliberately NOT a boolean beside a number. An `is_trade` flag and a `terms_days` column can
  // disagree — a trade customer with no terms, terms sitting on a retail customer — and then
  // something has to decide which of them is lying. One nullable column cannot contradict itself.
  account_terms_days Int?
  // ── WHO THE INVOICE IS ADDRESSED TO, WHEN THAT IS NOT THIS PERSON ─────────────────────────────
  // An employer paying for an employee's company car, a lease company, an insurer. NULL on both =
  // bill the customer, which is nearly every invoice a garage raises.
  //
  // THE ADDRESS IS ITS OWN COLUMN AND IS NEVER SUBSTITUTED. When account_name is set and this is
  // NULL the document prints no address at all, because the alternative a `??` would reach for is
  // the customer's HOME address under the company's name — a haulage firm addressed at an
  // employee's house, which is a worse document than one with no address on it.
  account_name       String?
  account_address    String?
  // ── CONTACT PREFERENCES (per channel — a customer may refuse SMS and still accept email) ────────
  // The GARAGE is controller of this consent, so it is tenant-scoped customer data, not a platform
  // record. THREE STATES, deliberately nullable: NULL = no record (unknown), true = opted OUT,
  // false = explicitly opted IN. Unknown must never render as "opted in"; for service messages
  // unknown means send. Enforced in lib/notify::sendNotification, which REFUSES rather than filters.
  sms_opt_out        Boolean?
  email_opt_out      Boolean?
  opt_out_updated_at DateTime? // when the preference was last set (who = AuditLog)
  created_at         DateTime  @default(now())

  // +++ CUSTOMER PORTAL LINK ---
  userId String? @unique
  user   User?

  // --- RELATIONS ---
  group      Group              @relation(fields: [group_id], references: [id], onDelete: Cascade)
  site       Site?              @relation(fields: [site_id], references: [id], onDelete: SetNull)
  vehicles   Vehicle[]
  ownerships VehicleOwnership[]
  bookings   Booking[]
  job_cards  JobCard[]
  threads    MessageThread[]

  @@index([group_id, site_id])
  @@index([group_id, phone_e164])
  @@index([group_id, email])
}

/// A JOB THE CAR NEEDS THAT NOBODY IS DOING TODAY — found at intake, surfaced next time.
///
/// ── WHY IT HANGS OFF THE VEHICLE ───────────────────────────────────────────────────────────────
/// The car is the identity that survives (the car-first re-root): the job card closes, the owner
/// may change, the car comes back. An item keyed to the card would die with the job it was found
/// on, and finding it again next year is the entire point.
///
/// ── THE CUSTOMER IS NEVER STORED HERE ──────────────────────────────────────────────────────────
/// DELIBERATE, and NOT an oversight to be "optimised" into a stored customer_id later. Who to
/// remind is resolved AT REMINDER TIME through the VehicleOwnership edge, because the car may have
/// changed hands between the finding and the reminder — and a reminder belongs to whoever owns it
/// then, not to whoever owned it in March. Same principle as every other derived read here.
model VehicleDueItem {
  id         String @id @default(uuid())
  group_id   String
  vehicle_id String

  /// PROVENANCE that outlives the job. SetNull, not Cascade: an admin hard-deleting a job card
  /// must not delete the fact that the car needs discs — the finding is about the CAR.
  found_on_job_card_id String?

  /// WHICH OBSERVATION THIS IS, when a machine wrote it — see lib/observation-keys.
  ///
  /// NULL means A HUMAN TYPED IT. That is the meaningful absence: a free-text finding has no key
  /// because nobody chose one, and it must never be matched by a writer looking for its own row.
  ///
  /// Before this column, machine writers found their open item by description PREFIX, which also
  /// matched hand-typed findings — "Battery terminals corroded" was rewritten into a battery
  /// advisory by the next test, silently. A key cannot collide with prose, and it survives a
  /// mechanic rewording the description.
  ///
  /// It is also the only way to count an observation across the book: "how many wiper blades did
  /// we spot and never sell" is unanswerable against a string.
  observation_key String?

  /// What the car needs, in the mechanic's words. Freeform because that is the bay reality.
  description String
  /// Optional link to the priced service, when it maps to one. NULLABLE on purpose: a catalogue
  /// entry can be retired (lib/catalogue-retire) and the finding must survive that.
  service_catalogue_id String?

  /// TRUE when the description already says WHEN, so appending dueLabel() would contradict it.
  ///
  /// Set by whoever AUTHORED the description — a catalogue field for a tapped observation, a
  /// property of the advisory for a measurement. NOT derived from observation_key: one `battery`
  /// key covers five states and only some carry timing, and splitting the key per state would
  /// break both re-testing-corrects-in-place and the partial unique index. NOT derived from the
  /// description text either — that is the mistake observation_key exists to undo.
  timing_in_description Boolean @default(false)

  /// WHICH CLOCK BINDS. Stated, never inferred — see DueBasis.
  ///
  /// ── A RESIDUAL UNTRUTH, RECORDED RATHER THAN PAPERED OVER ─────────────────────────────────
  /// Some findings have no clock at all. A battery advised for replacement before winter is not
  /// due at the next service, is not due on a defensible date (a November deadline would be a
  /// policy dressed as a measurement), and is not due at a mileage. It currently stores
  /// `next_service` because this column cannot say "no clock", and `timing_in_description` keeps
  /// that untruth off the customer's document — but it is still in the row, where the surfacing
  /// read and effectiveDueDate can see it.
  ///
  /// THE STATED OPTION, if a third such finding appears: make this NULLABLE — honest-null, "this
  /// has no clock" — rather than adding a fifth enum value. A nullable basis is the truthful model
  /// and every reader would have to handle it, which is the point. It is NOT done here because
  /// refuseDueItem deliberately requires a basis ("NOT inferred from which value is filled") and
  /// reversing a deliberate decision deserves its own report, not a quiet ride on someone's slice.
  due_basis   DueBasis
  /// The non-binding one may still be recorded as context; only the basis decides.
  due_date    DateTime?
  /// WHAT THE DATE KNOWS. `day` is a real calendar day; `month` means only the month and year were
  /// ever known and the stored day (always the 1st) was never meant — see lib/due-items::dueLabel,
  /// which is what stops an invented day reaching a customer's invoice.
  due_date_precision DueDatePrecision @default(day)
  due_mileage Int?

  /// The countdown this target was derived from, when the garage read one off the cluster rather
  /// than a target. See ServiceScheduleReading.countdown_miles for the whole reasoning — same fact,
  /// the other side of the visit. Counted from the DEPARTURE reading here, not arrival: "240 miles
  /// left" means from where the car is now, and after the work that is the odometer it leaves on.
  countdown_miles Int?

  /// HOW that reading was transcribed — see ScheduleReadingMode. Written ONLY by the schedule
  /// form's departure writer (pages/api/service-schedule), from what the SERVER resolved.
  ///
  /// NULL means "not written by the schedule form" — NOT "target". Measured 26 Aug 2026, after the
  /// schedule re-read migration: of 37 rows carrying a due_mileage across every tenant, 18 have a
  /// countdown and 19 do not. ALL 18 are on TMBS and all 18 came from the schedule form — that
  /// tenant is now fully covered. ALL 19 uncovered rows are on Kingsford, the demo tenant, whose
  /// rows were generated as targets. The earlier note here said "19 from the hand-typed findings
  /// form and 12 from the schedule"; that stopped being true and nothing made it say so, which is
  /// why this one carries the date it was taken.
  /// A tyre-derived target is a wear projection nobody transcribed, so the question has no answer
  /// for it. Only the schedule path can fill this in. Nothing reads it yet.
  mode ScheduleReadingMode?

  /// THREE-STATE, and there is NO default: the capture surface must make someone choose, or a
  /// mechanic tapping through at speed would silently record every finding as `not_raised` and
  /// `declined` — the only one that is a lead — would never appear.
  customer_response DueItemResponse
  /// When they answered. NULL for `not_raised`, because nobody answered: that is an absence of an
  /// event, not an event at time-unknown.
  response_at DateTime?

  /// Open until done or dismissed. `closed_job_card_id` names the job that finally did it.
  closed_at         DateTime?
  closed_job_card_id String?
  /// Why it was closed without being done, when that is what happened. NULL while open.
  closed_reason String?
  /// WHY it was closed, typed so it can be branched on: fixed | declined | no_longer_applies.
  /// `closed_reason` keeps the words; this decides the consequence — only `fixed` prints on the
  /// customer's document as work done. NULL means we do not know, which is the honest state of
  /// every closure written before 2026-08-20, when the only UI sent an id and nothing else.
  closed_kind String?

  created_by String?
  created_at DateTime @default(now())

  group             Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicle           Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  found_on_job_card JobCard? @relation("DueItemFoundOn", fields: [found_on_job_card_id], references: [id], onDelete: SetNull)
  closed_job_card   JobCard? @relation("DueItemClosedBy", fields: [closed_job_card_id], references: [id], onDelete: SetNull)

  /// The surfacing read: open items for a vehicle. Partial-index shape via the composite.
  @@index([group_id, vehicle_id, closed_at])
  /// The work-done block on an invoice reads exactly this pair.
  @@index([closed_job_card_id, closed_kind])
  /// A machine writer finding its OWN open item. Paired with a partial unique index on
  /// (group, vehicle, observation_key) WHERE closed_at IS NULL — declared in the migration, since
  /// Prisma cannot express a partial unique. One open item per observation per car, enforced.
  @@index([group_id, vehicle_id, observation_key])
  @@index([found_on_job_card_id])
  /// The customer's OWN answers, token-authenticated. See DueItemCustomerAnswer for why these are
  /// kept apart from `customer_response` above.
  customer_answers DueItemCustomerAnswer[]
  lines            DueItemLine[]
}

/// EVERY ODOMETER READING WE HAVE FOR A CAR — the MOT history DVSA already sends us, plus our own.
///
/// Before this, lib/dvsa fetched the whole `motTests` array and kept three scalars from it: an
/// eleven-year-old car arrived with ten readings and we stored one. No new API call is involved in
/// keeping the rest — it is a storage decision on data already in the response.
///
/// `source` matters and is not cosmetic: a garage should be able to tell "DVSA says" from "we read
/// it", and OUR readings are the denser stream for a regularly-serviced car — increasingly so as a
/// book matures, because an MOT is annual and a service visit is not.
///
/// The unique key is what makes re-lookup safe: the DVSA lookup fires on every reg search, so the
/// write is an idempotent upsert rather than an append that multiplies on each booking.
/// THE CUSTOMER'S OWN ANSWER to one finding on an intake report — token-authenticated, timestamped,
/// attributable.
///
/// ── TWO RECORDS, AND WHY THEY MUST NOT BE MERGED ────────────────────────────────────────────────
/// This is NOT the same fact as VehicleDueItem.customer_response, and the day someone "simplifies"
/// it into one field the product loses something it cannot get back:
///
///   THE CUSTOMER'S RECORD (here) is authoritative about WHAT THE CUSTOMER SAID.
///   THE GARAGE'S FIELD (VehicleDueItem.customer_response) is authoritative about WHAT THE GARAGE
///   WILL ACT ON.
///
/// They usually agree. When they disagree, someone has learned something new by phone — and that
/// disagreement must be LEGIBLE RATHER THAN IMPOSSIBLE. Merged into one column you cannot show
/// "they tapped no on the report, then rang and said yes"; a staff edit silently overwrites what
/// the customer actually did; and the evidential value of a token-authenticated answer — the whole
/// reason the link is a credential — is gone.
///
/// ── WHICH ONE THE ESTIMATE BUILDS FROM ──────────────────────────────────────────────────────────
/// The GARAGE field, always. That is the definition of that field, and a staff member who has just
/// taken a phone call holds newer information than a tap from this morning. A customer's answer
/// WRITES THROUGH to it (the office needs one field to read); a later staff edit overrides it. Last
/// write wins on the garage side; this table is append-only truth about the customer's own taps.
///
/// ── AND WHY NO ALERT FIRES ON A DISAGREEMENT ────────────────────────────────────────────────────
/// A divergence is created by a person doing something deliberate — recording what a customer just
/// told them. Notifying that person about their own action is noise, and noise is how an
/// escalation stops being read. The right moment is BEFORE: the customer's answer is shown inline
/// beside the field being changed, so the override is informed rather than announced afterwards.
/// The divergence then stays visible on the finding, permanently.
model DueItemCustomerAnswer {
  id           String @id @default(uuid())
  group_id     String
  due_item_id  String

  answer      CustomerAnswer
  answered_at DateTime       @default(now())

  /// The link the answer arrived through — what makes it attributable. NULLABLE only for an answer
  /// recorded by another route later; today every row has one.
  magic_link_id String?

  group     Group          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  due_item  VehicleDueItem @relation(fields: [due_item_id], references: [id], onDelete: Cascade)

  /// APPEND-ONLY: a customer who changes their mind on the same report leaves two rows, in order.
  @@index([due_item_id, answered_at])
  @@index([group_id])
}

/// A FINDING THAT BECAME A PRICED LINE — the link between what the car needed and what was sold.
///
/// ── WHY THIS IS NOT A COLUMN ON EITHER SIDE ─────────────────────────────────────────────────────
/// One finding can become SEVERAL lines (discs, pads, and the labour to fit them), and a line can
/// legitimately serve one finding only. A join table says both; a foreign key on JobCardItem would
/// say the second and lie about the first.
///
/// ── AND WHY INVOICING DOES NOT CLOSE THE FINDING ────────────────────────────────────────────────
/// THE CASE THAT DECIDES IT: a customer says yes to discs AND pads. The garage fits the discs
/// today and the pads next month. One invoice, one finding genuinely finished, one still open.
/// Auto-closing on invoice would clear BOTH — silently, and in the direction that loses work the
/// customer has already agreed to buy.
///
/// So closure is DERIVED AND OFFERED, never automatic: when every line linked to a finding sits on
/// an issued invoice, the card offers "mark done" pre-ticked and a human confirms in one tap. That
/// keeps the marketing list clean without a rule that quietly clears things nobody checked.
model DueItemLine {
  id          String @id @default(uuid())
  group_id    String
  due_item_id String
  /// The estimate line this finding turned into.
  job_card_item_id String

  /// Who linked them, and when. A link is a judgement — "this line is that finding" — not a fact
  /// the system derived, so it carries an author.
  linked_by String?
  created_at DateTime @default(now())

  group     Group          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  due_item  VehicleDueItem @relation(fields: [due_item_id], references: [id], onDelete: Cascade)
  /// Cascade: a deleted estimate line takes its link with it. The FINDING survives — it is about
  /// the car, and deleting a line is a pricing decision, not a statement that the car is fine.
  job_card_item JobCardItem @relation(fields: [job_card_item_id], references: [id], onDelete: Cascade)

  /// One line serves one finding. Re-linking the same pair is a no-op, not a duplicate.
  @@unique([due_item_id, job_card_item_id])
  @@index([group_id, due_item_id])
  @@index([job_card_item_id])
}

/// ONE TYRE, MEASURED AT THREE POINTS ACROSS THE TREAD.
///
/// ── WHY THREE READINGS AND NOT ONE ──────────────────────────────────────────────────────────────
/// THIS IS THE WHOLE REASON THIS TABLE EXISTS, and the thing someone will otherwise "simplify" to a
/// single depth. A car worn on the INSIDE EDGES is a tracking job as well as a tyre job. One depth
/// hides that completely: a tyre reading 6/3/2mm and a tyre reading 4/4/4mm average about the same
/// and mean entirely different things — the first is a wheel alignment the garage would never have
/// been asked to quote for.
///
/// So a measurement raises up to TWO advisories from one reading: a worn tyre (depth below the
/// threshold) and, separately, worn alignment (asymmetry across the tread). The second is a
/// different job to sell, and it is invisible to any model that stores one number.
///
/// A free-text VehicleDueItem cannot hold this. The structure IS the finding.
model TyreReading {
  id          String @id @default(uuid())
  group_id    String
  vehicle_id  String
  /// The visit it was taken on. SetNull, like a due item's provenance: the reading is about the CAR
  /// and must outlive the card it was captured on — the history is what produces a wear rate.
  job_card_id String?

  corner TyreCorner
  type   TyreType

  /// Tread depth in TENTHS of a millimetre, across the tread. Integers, because 1.6mm is a legal
  /// threshold and floating point has no business near it.
  /// outer = the shoulder nearest the kerb; inner = nearest the car's centreline.
  depth_outer_tenths  Int
  depth_centre_tenths Int
  depth_inner_tenths  Int

  measured_at DateTime @default(now())
  measured_by String?

  group    Group          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle        @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  job_card JobCard?       @relation(fields: [job_card_id], references: [id], onDelete: SetNull)

  /// One reading per corner per visit — re-measuring a corner corrects it rather than stacking.
  @@unique([job_card_id, corner])
  /// The wear-rate read: this car's readings for one corner, oldest first.
  @@index([group_id, vehicle_id, corner, measured_at])
}

/// How a battery's cold-cranking rating was measured. EN, SAE, DIN and JIS give DIFFERENT numbers
/// for the same battery, so a rated CCA without its standard is not comparable to another rated
/// CCA — and the health percentage is computed against it. Stored beside the rating, never apart.
enum CcaStandard {
  EN
  SAE
  DIN
  JIS
  IEC
  /// "The label does not say" — the honest answer for most UK batteries, whose labels print a
  /// rating and name no standard. NOT a sixth way of rating one: it is the absence of one, said
  /// out loud, so lib/battery::ratingsComparable can refuse a comparison on it.
  UNSTATED
}

/// A BATTERY TEST — three numbers off the tester, and the denominator the third was computed from.
///
/// ── WHY THIS IS A TABLE AND NOT COLUMNS ON THE FINDING ──────────────────────────────────────────
/// The reasoning is NOT the tyre reasoning, and copying that would produce the wrong key. Tyres
/// earned a table on cardinality and internal structure: four corners, and a spread ACROSS one
/// tread that is a second finding. A battery has neither — one component, and three quantities
/// that do not relate to each other spatially.
///
/// What earns it here is EVIDENCE vs CONCLUSION, and TRAJECTORY. A VehicleDueItem is what the car
/// needs; this is what was measured. The conclusion can be wrong (see lib/battery's RETEST state),
/// so the evidence has to survive independently of it. And 62% -> 41% -> 17% across three visits is
/// a decline rate — the only thing that makes "it will not start in November" an earned claim
/// rather than a scare. Hanging these columns on VehicleDueItem would also leave them null on
/// substantially every finding, where null would mean "does not apply" rather than "unknown".
///
/// ── ONE PER VISIT ───────────────────────────────────────────────────────────────────────────────
/// Unique on job_card_id ALONE. There is no corner here and inventing one would be cargo-culting
/// the tyre key. Some vans and diesels do carry two batteries; nobody has hit that yet, and the fix
/// when someone does is an additive `position` column with a default plus widening this unique to
/// (job_card_id, position). Recorded so the next reader finds the reasoning rather than the limit.
///
/// Replay-safe by construction, like TyreReading and unlike a due item: a redelivered outbox
/// envelope upserts on the natural key, so the phone sends no client-supplied id.
/// Why a car is on a marketing list. Two reasons, two lists, two badges' worth of work.
/// What the garage did about it. `contacted` is not an outcome — it is the first step — but it is
/// enough to take the car off the badge, which is the badge's whole job.
enum MarketingState {
  contacted
  booked
  declined
  snoozed
}

/// WHAT A GARAGE HAS DONE ABOUT A CAR THAT IS DUE.
///
/// Without this the Marketing section is a report, and a badge over a report only ever grows. One
/// row per (vehicle, reason), updated in place; the history lives in AuditLog.
///
/// `booked` TRUSTS THE TAP — it does not check that a booking exists. Verifying against a real
/// Booking is right eventually and is a second thing to get wrong today, so the consequence is
/// stated instead: a car marked booked that never was disappears from the list until `for_date`
/// passes, at which point it comes back.
model MarketingContact {
  id         String @id @default(uuid())
  group_id   String
  vehicle_id String

  /// WHAT THE CALL WAS ABOUT — a record, not part of the identity (see the unique index below).
  /// A LeadReasonKind from lib/marketing-pipeline, constrained in the database. It was an enum of
  /// the two LIST NAMES the board used to have, so once the lists went it could only record which
  /// tab a row came from — and every row comes from the same place now, so it said 'mot' for a car
  /// rung about a failed battery.
  reason String
  state  MarketingState

  /// The trigger this contact was about. The record is SPENT once it passes — see the migration.
  for_date DateTime
  /// Set if and only if state is `snoozed`, enforced by a CHECK constraint: a snooze with no end
  /// is a hide, and a hide is how a list quietly empties.
  snooze_until DateTime?

  /// HOW it went out: 'sms' | 'email' | 'both', constrained in the database. NULL means we do not
  /// know — a phone call, or any contact recorded before sending existed. Written only by a send,
  /// so a non-null value always means GreaseDesk sent the message. NOT a fifth state: a texted car
  /// is a contacted car, and two words for one fact is a choice nobody should have to make.
  channel String?

  actor_id   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  group   Group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  /// ONE ANSWER PER CAR. A garage makes one phone call about a car, and the board is one row per
  /// car carrying every reason it is worth ringing about — so keying on `reason` too would let a
  /// car be contacted under one and not-contacted under another after a single call.
  @@unique([group_id, vehicle_id])
  @@index([group_id, for_date])
}

/// WHAT THE SERVICE COMPUTER SAID ON ARRIVAL — a fact about a VISIT, not about a car.
///
/// The departure reading is what the car needs next and is a VehicleDueItem; this is what was due
/// when it came in. Keeping only one of them collapses "60,000 on arrival, 70,000 after" — a
/// completed sale — into the same row as "60,000 on arrival, still 60,000 after", which is a job
/// that walked. Never printed on an invoice: the customer's document says what the car needs NEXT.
///
/// Shaped like TyreReading and BatteryReading, with one deliberate difference: job_card_id is NOT
/// NULL and cascades. A tyre depth outlives its card because it is about the car; this does not,
/// because without the visit there is no reading.
/// WHICH CONVENTION THE SCREEN WAS SHOWING when a garage transcribed a service computer.
///
/// `countdown_miles` records what was typed and `due_mileage` what it resolved to, but neither can
/// say what a NULL countdown means: "the garage typed an absolute target" and "this row predates
/// the countdown column" are the same null. Every mileage-bearing row written before 2026-08-23 is
/// the second, and all of them read as intervals typed into a target-mode box.
///
/// `unknown` exists so that question has an answer other than a guess. Two values would be a
/// boolean, and a boolean cannot say "nobody recorded which".
enum ScheduleReadingMode {
  target
  countdown
  unknown
}

model ServiceScheduleReading {
  id          String @id @default(uuid())
  group_id    String
  vehicle_id  String
  job_card_id String

  /// A key from lib/service-schedule's catalogue. Not an enum: the catalogue is code, and a new
  /// item should not need a migration to be readable.
  item_key String

  /// The 1st of the month — month precision by construction, because a service computer prints
  /// "11/2025". A row must carry at least one leg (CHECK constraint).
  ///
  /// TRANSCRIPTION NOTE, so it is not rediscovered as a defect: the cluster prints "10/2027" and
  /// the form is an <input type="month">, which Chrome renders "October 2027" in en-GB AND en-US
  /// (screenshotted, not assumed). A substitution, not a re-ordering — and deliberately kept,
  /// because a free-text numeric field would invite "2027/10".
  due_month   DateTime?
  due_mileage Int?

  /// WHAT THE SCREEN ACTUALLY SAID, when the garage read a countdown rather than a target.
  ///
  /// A MINI cluster shows distance REMAINING — "1,240 mi", or "-240 mi" with "Service overdue" —
  /// never the odometer the service falls due at. `due_mileage` above is derived from it and the
  /// car's reading; this is the measurement that derivation came from.
  ///
  /// Kept because the derivation's other input can MOVE. Mileage-in is editable: correct a
  /// mis-keyed odometer and a stored target becomes silently wrong with nothing to re-derive it
  /// from. With this column the row explains itself and survives the correction — and the odometer
  /// it was counted from needs no column of its own, being due_mileage minus this.
  ///
  /// NULL means the garage entered an absolute target, which is a different thing from a countdown
  /// of zero (a service due at exactly this reading).
  countdown_miles Int?

  /// HOW the reading above was transcribed — see ScheduleReadingMode. Written ONLY by the schedule
  /// form's writer (pages/api/service-schedule), from what the SERVER resolved, never from what a
  /// client claimed: the same rule the due_mileage/countdown_miles pair already lives under.
  ///
  /// NULL means "not written by the schedule form" — NOT "target". Rows predating this column are
  /// null and stay null: a backfill to `unknown` would write a value where absence already says it,
  /// and would be indistinguishable from a garage that actively chose it. Nothing reads it yet.
  mode ScheduleReadingMode?

  recorded_by String?
  recorded_at DateTime @default(now())

  group    Group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  job_card JobCard @relation(fields: [job_card_id], references: [id], onDelete: Cascade)

  /// One reading per item per visit — re-reading corrects, as (job_card_id, corner) does for tyres.
  @@unique([job_card_id, item_key])
  @@index([group_id, vehicle_id, recorded_at])
}

model BatteryReading {
  id         String @id @default(uuid())
  group_id   String
  vehicle_id String

  /// The visit it was taken on. SetNull for the same reason as a tyre reading: the measurement is
  /// about the CAR and must outlive the card, because the history is what produces a decline rate.
  job_card_id String?

  /// Resting voltage in MILLIVOLTS. Integers, because 10.5V is a threshold and floating point has
  /// no business near a threshold — the same argument as tread depth in tenths.
  voltage_mv Int
  /// State of charge, whole percent. How full it is NOW — says nothing about condition on its own.
  soc_pct Int
  /// State of health, whole percent, against the rated CCA below. What the tester thinks the
  /// battery has left relative to new. UNRELIABLE at low charge — lib/battery refuses to act on it.
  soh_pct Int

  /// THE DENOMINATOR the health figure was computed against — typed into the tester by hand, so a
  /// wrong entry makes a plausible and completely wrong health reading. NULL is honest (nobody
  /// recorded what it was set to); it cannot be retrofitted, which is why it is captured at all.
  /// Both this and its standard are set together or neither is — enforced by a CHECK constraint.
  rated_cca     Int?
  cca_standard  CcaStandard?

  measured_at DateTime @default(now())
  measured_by String?

  group    Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  job_card JobCard? @relation(fields: [job_card_id], references: [id], onDelete: SetNull)

  /// One test per visit — retesting the same car on the same visit corrects it rather than stacking.
  @@unique([job_card_id])
  /// The decline-rate read: this car's tests, oldest first.
  @@index([group_id, vehicle_id, measured_at])
}

model VehicleOdometerReading {
  id         String @id @default(uuid())
  group_id   String
  vehicle_id String

  /// 'mot' (DVSA test history) | 'visit' (odometer_in, read by us at the car).
  source       String
  reading_date DateTime @db.Date
  /// MILES, normalised at the boundary. DVSA reports an odometerUnit of mi OR km; an unrecognised
  /// unit stores NO reading rather than a guessed number (lib/odometer refuses it).
  miles        Int

  created_at DateTime @default(now())

  group   Group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@unique([vehicle_id, source, reading_date])
  @@index([group_id, vehicle_id, reading_date])
}

model Vehicle {
  id                      String    @id @default(uuid())
  group_id                String
  customer_id             String? // WELD retired (Stage C): nullable + SetNull + unwritten. Owner source is the ownership edge.
  // Car-first re-root (Stage A, additive). identity_id links to the stable VIN-soft-anchored
  // VehicleIdentity (1:1 now, mergeable cross-tenant later). vin_normalized is the canonical
  // dedup key (upper/strip). Ownership moves to the VehicleOwnership edge — customer_id above
  // stays required through Stage A/B and is retired last.
  identity_id             String?
  vin_normalized          String?
  registration            String
  // Canonical match key (uppercase, non-alphanumeric stripped) so "BK69 YAV" / "bk69yav" resolve to
  // ONE vehicle — mirrors vin_normalized. find-or-create + reg lookup compare on this, never the raw.
  registration_normalized String?
  vin                     String?
  make                    String?
  model                   String? // NOT in free DVLA VES — captured manually
  derivative              String?
  colour                  String? // DVLA VES
  fuel_type               String? // DVLA VES (fuelType)
  transmission            String?
  engine_code             String?
  engine_cc               Int? // DVLA VES engine capacity (cc) — also the seed for a future auto-tier hook
  year                    Int? // DVLA VES (yearOfManufacture)
  // DVSA MOT History — captured for the banked service-reminder feature (mot_expiry) + mileage trend.
  mot_expiry              DateTime? @db.Date
  last_mot_mileage        Int?
  last_mot_date           DateTime? @db.Date
  /// When DVSA last ANSWERED about this car — an instant, not a calendar day. Written only on a
  /// successful lookup: a failed one teaches nothing, and stamping it would let the row claim a
  /// freshness it does not have. Stored rather than held in the page because two people work the
  /// same marketing list. See pages/api/mot-refresh.
  mot_checked_at          DateTime?
  mileage_at_create       Int?
  created_at              DateTime  @default(now())

  group      Group              @relation(fields: [group_id], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  identity   VehicleIdentity?   @relation(fields: [identity_id], references: [id], onDelete: SetNull)
  ownerships VehicleOwnership[]
  bookings   Booking[]
  job_cards  JobCard[]
  threads    MessageThread[]
  due_items  VehicleDueItem[]
  odometer_readings VehicleOdometerReading[]

  @@index([group_id, customer_id])
  @@index([registration])
  @@index([identity_id])
  @@index([group_id, vin_normalized])
  @@index([group_id, registration_normalized])
  tyre_readings    TyreReading[]
  battery_readings BatteryReading[]
  marketing_contacts MarketingContact[]
  schedule_readings  ServiceScheduleReading[]
}

// Car-first re-root: the stable, VIN-soft-anchored identity underneath a Vehicle. Tenant-scoped
// NOW (group_id) but shaped to go cross-tenant later WITHOUT a re-root — a future migration merges
// identities sharing a VIN across tenants by re-pointing Vehicle.identity_id. VIN is the PREFERRED
// anchor when present (unique per tenant), reg is the fallback, the uuid id is the anchor underneath.
model VehicleIdentity {
  id             String   @id @default(uuid())
  group_id       String
  vin_normalized String? // canonical VIN (upper/strip); NULL when no VIN captured yet
  registration   String? // reg fallback (regs recycle → not unique)
  created_at     DateTime @default(now())

  group    Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([group_id, vin_normalized]) // VIN unique PER TENANT when present (NULLs distinct)
  @@index([group_id, registration])
}

// Ownership as a time-bounded EDGE (not a column). Current owner = the row with is_current = true
// (one per vehicle, enforced by a partial-unique index added in raw SQL). Owner history = all rows.
// This is the seam a future garage-mediated transfer will use (close current edge, open a new one);
// no transfer mechanism is built here. PII stays on Customer — this edge only references it.
model VehicleOwnership {
  id          String    @id @default(uuid())
  vehicle_id  String
  customer_id String
  is_current  Boolean   @default(true)
  valid_from  DateTime  @default(now())
  valid_to    DateTime? // NULL = current; set on a future transfer
  created_at  DateTime  @default(now())

  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([vehicle_id])
  @@index([customer_id])
  @@index([vehicle_id, is_current])
}

model ServiceCatalogue {
