  group_id   String
  user_id    String?
  entity     String
  entity_id  String
  action     String
  diff_json  Json?
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([group_id])
  @@index([user_id])
