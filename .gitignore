/node_modules
/.next/
/out/
/dist/
/coverage

# Environment
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env.staging.local # Added common staging environment
env_file.txt        # Never commit ad-hoc env dumps (this file leaked a live DB URL once)
