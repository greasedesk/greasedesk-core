model JobCard {
  // PROVENANCE: created by the Invoice Import wizard rather than lived through the workshop.
  // Imported cards are excluded from the unpaid-invoice chaser and marked on dashboard periods.
  is_imported            Boolean       @default(false)
  import_batch_id        String?
  id                     String        @id @default(uuid())
  group_id               String
  site_id                String
  profit_centre_id       String? // reporting tag (optional); operational link is site_id (+ resource, later)
  customer_id            String?
  vehicle_id             String
  status                 JobCardStatus @default(draft)
  mechanic_assigned_id   String?
  odometer_in            Int?
  odometer_out           Int?
  vat_rate               Decimal       @default(20) @db.Decimal(5, 2) // per-quote VAT rate (editable, 0–100)
  completed_at           DateTime?
  archived_at            DateTime?
  signed_off_by_customer Boolean       @default(false)
  signed_off_at          DateTime?
  // WHEN THE CUSTOMER SAID YES. Written ONLY by lib/quote-acceptance, by every acceptance path,
  // whether or not a QuoteVersion exists — 96% of real quoting is verbal and mints no version, so
  // the version could never be the home for this. Deliberately NOT a minted version: `status:
  // 'accepted'` on a QuoteVersion is load-bearing in lib/invoice-issue, where an accepted version
  // makes the invoice a column copy of its FROZEN lines. Minting one on a verbal acceptance would
  // silently bill the estimate as it stood at the handshake and drop anything found afterwards.
  accepted_at            DateTime?
  created_at             DateTime      @default(now())

  // --- SLICE 1: flags (main tab) ---
  flag_urgent       Boolean @default(false) // Urgent / Priority
  flag_sales_car    Boolean @default(false)
  flag_customer_car Boolean @default(false)
  flag_mot          Boolean @default(false) // MOT bay needed
  flag_diag         Boolean @default(false) // Diagnostic
  // Warranty / comeback: work redone free (a job came back). REAL cost (parts/labour still on the
  // estimate) but ZERO revenue — reporting reads revenue as 0 when set, cost unchanged. Faithful margin.
  is_comeback       Boolean @default(false)

  // --- SLICE 1: four-stage status (each Pending=false / Done=true) ---
  stage_details_done     Boolean @default(false) // 1. Job Card (details/estimate)
  stage_intake_done      Boolean @default(false) // 2. Intake Photos
  stage_injob_done       Boolean @default(false) // 3. In-Job
  stage_complete_done    Boolean @default(false) // 4. Complete Photos
  // Photo stages are SOFT gates: complete OR skipped advances the spine (capture can't be enforced).
  // A skip is a first-class audited event (actor + timestamp + optional reason in the audit diff).
  // Details has NO skip — it's a data gate, not a capture stage.
  /// THE DIAGNOSTIC SCAN WAS RUN AND ITS REPORT SENT ON — a confirmation, not a capture: the scan
  /// happens on an external tool and the report is emailed elsewhere, so there is no artefact here
  /// to point at. NULL means nobody has ticked it, which is the only honest reading of a card that
  /// predates the tick as well as one where the scan was never done — we cannot tell those apart
  /// and must not pretend to. Undoable, so a mis-tap clears both columns; the AuditLog keeps the
  /// tick and the correction. Same shape as intake_nothing_found_at/_by.
  diag_scan_at           DateTime?
  /// The user who ticked it. NULL exactly when diag_scan_at is null — set and cleared together.
  diag_scan_by           String?

  stage_intake_skipped   Boolean @default(false)
  stage_injob_skipped    Boolean @default(false)
  stage_complete_skipped Boolean @default(false)

  // --- DIARY scheduling ---
  // start_at / end_at are the SOURCE OF TRUTH for scheduling (continuous time).
  held_on_lift             Boolean   @default(false) // job occupying a lift open-endedly (e.g. awaiting parts)
  garage_notes             String? // internal staff notes on the job
  resource_id              String?
  start_at                 DateTime? // scheduling start (source of truth)
  // Booking WORKING duration (minutes) — the occupancy-footprint SOURCE OF TRUTH. The footprint,
  // its per-day segments, and end_at are derived from (start_at + this + site hours) via lib/occupancy.
  booking_duration_minutes Int?
  end_at                   DateTime? // DERIVED convenience = footprint true wrapped end. Diary week-fetch bound +
  // display only; never source of truth (duration wins). Guard ignores it.
  // Legacy slot model — retained until retired in a later slice; no longer read.
  scheduled_date           DateTime? @db.Date
  start_slot               Int?
  end_slot                 Int?

  // --- DUPLICATE (estimate recovery) ---
  // Provenance edge: this card was created by copying another card's estimate. SetNull so an admin
  // hard-delete of the source never breaks the copy. The creation audit row carries the source
  // registration too (self-describing), so the trail survives even a nulled edge.
  duplicated_from_id String?
  // Costs on this card were inherited from the source at duplicate time and may be stale. Cleared
  // by the FIRST estimate save (the operator has looked at the numbers) — until then the Quote tab
  // shows a check-your-supplier-costs advisory.
  costs_inherited    Boolean @default(false)

  group             Group               @relation(fields: [group_id], references: [id], onDelete: NoAction)
  site              Site                @relation(fields: [site_id], references: [id], onDelete: NoAction)
  profit_centre     ProfitCentre?       @relation(fields: [profit_centre_id], references: [id], onDelete: NoAction)
  customer          Customer?           @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  vehicle           Vehicle             @relation(fields: [vehicle_id], references: [id], onDelete: NoAction)
  mechanic_assigned User?               @relation("JobCardMechanic", fields: [mechanic_assigned_id], references: [id], onDelete: SetNull)
  resource          Resource?           @relation(fields: [resource_id], references: [id], onDelete: SetNull)
  photos            JobCardPhoto[]
  items             JobCardItem[]
  invoice           Invoice?
  magicLinks        CustomerMagicLink[]
  quoteVersions     QuoteVersion[]
  duplicated_from   JobCard?            @relation("CardDuplicate", fields: [duplicated_from_id], references: [id], onDelete: SetNull)
  duplicates        JobCard[]           @relation("CardDuplicate")

  @@index([group_id, site_id, profit_centre_id, customer_id, vehicle_id])
  @@index([status])
  @@index([resource_id, scheduled_date])
  @@index([resource_id, start_at])
  @@index([duplicated_from_id])
  due_items_found    VehicleDueItem[] @relation("DueItemFoundOn")
  due_items_closed   VehicleDueItem[] @relation("DueItemClosedBy")

  /// ── "CHECKED, NOTHING FOUND" ──────────────────────────────────────────────────────────────────
  /// The affirmative that keeps the escalation honest. Absence of findings is NOT absence of
  /// looking: without this, a car that genuinely needs nothing can never satisfy the findings
  /// prompt, so a mechanic who did the job properly is forced to skip — and the admin gets a false
  /// escalation. Enough of those and the email is ignored, which kills the whole escalation design.
  ///
  /// CLEARED when a due item is recorded on this card: the current state is then "findings exist",
  /// and a stale affirmative alongside real findings would say two things at once. The audit log
  /// keeps the history of both.
  intake_nothing_found_at DateTime?
  intake_nothing_found_by String?
  tyre_readings      TyreReading[]
  battery_readings   BatteryReading[]
  schedule_readings  ServiceScheduleReading[]
}

model JobCardPhoto {
  id               String   @id @default(uuid())
  job_card_id      String
  /// TENANT partition, and the R2 key prefix — garages never see each other's photos.
  /// NOT NULL, and this one is a DELETION GUARANTEE, not tidiness. The purge deletes R2 objects by
  /// the prefix `{group_id}/`; a photo written without a tenant lands at the bucket root and would
  /// SURVIVE a purge that reported success. lib/r2::photoKey refuses to build such a key; this
  /// stops the row existing at all. 0 of 63 rows were ever null — the absence was never meaningful.
  group_id         String
  stage            String? // intake | injob | completion
  slot             String? // angle key (front/rear/…) | 'freeform' | 'damage'
  label            String? // free-text (damage note, e.g. "Scratch — nearside door")
  media_type       String? // 'photo' | 'video' — NULL means photo (pre-video rows; never backfilled)
  duration_seconds Int? // video length (client-probed metadata; display only)
  /// The private R2 object key; display via a presigned GET (the URL is never stored).
  /// NOT NULL. A row without one names an object nothing can reach — not a leak, but an orphan
  /// that no reader can render and no operator can find. lib/r2::photoKey is the only builder and
  /// it refuses rather than returning something unusable, so a null here could only ever mean a
  /// caller forgot. 0 of 63 rows were ever null.
  r2_key           String
  poster_r2_key    String? // VIDEO ONLY: a small JPEG poster frame (captured client-side ~1-2s into
  // the clip), its own R2 object. NULL = pre-poster video → placeholder tile.
  rotation         Int      @default(0) // 0/90/180/270 — a display INTERPRETATION applied as a CSS
  // transform (grid + lightbox). NEVER re-encodes or rewrites the R2 bytes.
  photo_type       String?
  file_url         String? // legacy (pre-R2); nullable now
  uploaded_by      String?
  uploaded_at      DateTime @default(now())

  job_card JobCard @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  user     User?   @relation("JobCardPhotoUploader", fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([job_card_id])
  @@index([job_card_id, stage])
}

model JobCardItem {
  cost_basis        String? // 'actual' | 'estimated' — provenance of unit_cost on an imported line
  id                String   @id @default(uuid())
  job_card_id       String
  item_type         ItemType
  description       String
  qty               Decimal  @default(1.00) @db.Decimal(12, 2)
  // NULLABLE (2026-07-17): null = trade cost UNKNOWN (ad-hoc part not yet catalogued); a number
  // (incl. 0 = genuinely free, e.g. a discount line) = known. The margin readers EXCLUDE null and
  // surface it — never silently count unknown as zero. The catalogue is the cost home.
  unit_cost         Decimal? @db.Decimal(12, 2)
  unit_price        Decimal  @default(0) @db.Decimal(12, 2)
  vat_rate          Decimal  @default(20.00) @db.Decimal(5, 2)
  vat_amount        Decimal  @default(0) @db.Decimal(12, 2)
  labour_hours      Decimal? @db.Decimal(6, 2) // fixed lines: inherited labour content; ad-hoc labour lines carry hours in qty
  labour_outsourced Boolean  @default(false) // inherited from the product at save — frozen per-line (re-flagging a product never rewrites history)
  created_at        DateTime @default(now())

  /// THE ESTIMATOR'S ORDER, zero-based, as the rows sat on the form when it was saved.
  ///
  /// It exists because created_at cannot express it. The quote save writes every line in one
  /// createMany and Postgres now() is the TRANSACTION timestamp, so all of a card's lines share one
  /// created_at — measured on TMBS as 144 of 144 cards with two or more lines. The freeze ordered by
  /// that column and stamped InvoiceLine.position from the result, which made the printed order of a
  /// customer's invoice a tie-break nobody chose.
  ///
  /// NULL MEANS THE ROW PREDATES THIS COLUMN AND ITS ORDER IS UNKNOWN. Not "defaults to created_at"
  /// — created_at is what could not answer the question. There is no backfill: the only orders
  /// available to one would be that tie or the surrogate id, and writing either would record a
  /// decision nobody made as though somebody had. Rows written before 2026-08-23 keep the ordering
  /// they have always had, which is arbitrary, and say so by being null.
  ///
  /// A card is all-null or all-set, never mixed: a save rewrites every line on the card together.
  position Int?

  // Origin hook: which catalogue item pre-filled this line (for the future per-item margin lens).
  // SetNull so archiving/deleting the catalogue item never breaks a historic line.
  catalogue_item_id String?

  job_card  JobCard        @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  catalogue CatalogueItem? @relation(fields: [catalogue_item_id], references: [id], onDelete: SetNull)

  @@index([job_card_id])
  @@index([catalogue_item_id])
  due_item_links   DueItemLine[]
}

// Lightweight labelled diary entry — NOT a job card (no customer/vehicle/quote). A note may be
// lift-specific (resource_id set — occupies a lift visually) or day-level (resource_id null —
// a floating annotation like "Hugh at Drs"). Holidays/leave are a separate HR concern, not notes.
