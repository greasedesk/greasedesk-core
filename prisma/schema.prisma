model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────────────────────────────────────────
// Invoicing — GreaseDesk IS the primary VAT invoice (replaces Xero at issue). Numbers are minted
// once (assignInvoiceNumber) and rendered once (formatInvoiceNumber); freeze-on-paid = canEditInvoice.
// The header is SNAPSHOT at issue so later profile edits never rewrite history.
// ───────────────────────────────────────────────────────────────────────────────

model Invoice {
  // PROVENANCE. external_ref carries the ORIGINAL system's number (Xero) — the GreaseDesk series
  // is still minted normally and stays gapless; on imported invoices the UI shows external_ref as
  // the primary number with the GreaseDesk number secondary.
  is_imported             Boolean       @default(false)
  external_ref            String?
  cost_basis              String? // 'actual' | 'estimated' | 'mixed' — how the parts costs behind this were obtained
  id                      String        @id @default(uuid())
  group_id                String // tenantId
  job_card_id             String        @unique // one invoice per card; sticky number on re-issue
  site_id                 String
  status                  InvoiceStatus @default(issued)
  series                  InvoiceSeries @default(chargeable) // which counter minted sequence_value
  sequence_value          Int // monotonic counter value underneath the rendered number
  invoice_number          String? // rendered string; set at issue, sticky thereafter
  issued_at               DateTime      @default(now())
  /// The DOCUMENT issue/billing date (defaults from mint; manager-editable, audited) — issued_at
  /// stays the mint attestation.
  ///
  /// IT DOES NOT MOVE ON A RE-ISSUE, and that is a decision rather than an omission. Unlocking makes
  /// a document provisional and a re-issue rebuilds its lines, its advisory and its subject — but
  /// the TAX POINT is when the work was supplied, not when a corrected document was printed.
  /// Re-dating a correction would shift the supply into whatever period the correction happened in,
  /// which is a different claim about when the sale occurred and one nobody made.
  date_issued             DateTime?
  /**
   * When payment is due. NULL = due on collection — a garage does not release a car until the bill
   * is paid, so retail work has no due date and is not capable of being overdue.
   * FROZEN AT ISSUE, like the lines: derived once from date_issued + the customer's terms AT THAT
   * MOMENT. Re-deriving it later would let a change of terms silently re-age last year's invoices.
   */
  due_date                DateTime?
  /**
   * ── WHAT WAS ACTUALLY RECEIVED, in pennies. NULLABLE = UNKNOWN. ────────────────────────────────
   * Payment used to be a boolean wearing a date: status `paid` plus paid_at, with no amount
   * anywhere. That works right up until an invoice is corrected AFTER it has been paid, and then
   * the product cannot say the sentence a garage says every week — "£551.26 received, £30 still
   * outstanding". Marking it paid claims £30 that never arrived; leaving it unpaid overstates the
   * debt by £551.26. There was no third option because there was nowhere to put the number.
   * Written at mark-paid from the total AT THAT MOMENT, and preserved through unlock and re-issue.
   * Everything else derives: balance = total − amount_paid; positive is outstanding, negative is a
   * refund owed. NULL on every invoice that predates this column — unknown, never 0, because 0
   * would read as "nothing was received" on invoices that were paid in full years ago.
   */
  amount_paid_pennies     Int?
  /**
   * APPEND-ONLY amendment log: [{ at, by, fromPennies, toPennies, wasSent, wasPaid }]. Same shape
   * as void_reason_corrections and EmploymentEvent.correction_json. A re-issue keeps the invoice
   * NUMBER, so the customer can end up holding two documents that differ; this is what makes them
   * distinguishable, and it is append-only so a second amendment cannot erase the first.
   */
  amendments              Json?
  paid_at                 DateTime?
  date_paid               DateTime? // the DOCUMENT fact (defaults from mark-paid; manager-editable, audited) — paid_at stays the attestation
  payment_method_id       String? // how it was paid (grain for method reporting — banked tile)
  payment_method_snapshot String? // method name at mark-paid; renames never rewrite history
  confirm_due_at          DateTime? // paid_pending only: when the clearance window elapses (cron confirms then)
  receipt_sent_at         DateTime? // confirmation receipt delivered; null on a confirmed invoice = visibly "receipt not sent"
  // --- VOID grain. The explanation VATREC5010 asks for lives ON the document it explains, not in
  // a side table a reader has to know to join. Set together, in one transaction, or not at all.
  voided_at               DateTime?
  voided_by               String? // User.id of the admin who retired it — never a system actor
  void_category           String? // one of lib/invoice-void VOID_CATEGORIES
  void_reason             String? // free text, MANDATORY (see lib/invoice-void for why this one is)
  // APPEND-ONLY correction log for `void_reason`, the SAME shape as EmploymentEvent.correction_json:
  // [{ at, by, from, to }]. The reason is the record an inspector reads, so a thin one must be
  // improvable — but never by quietly overwriting it. `void_reason` holds the CURRENT text and the
  // first entry's `from` holds the original, so both are always recoverable and both are displayed.
  void_reason_corrections Json?

  // Header snapshot captured at ISSUE (resolved values — never rewritten by later profile edits).
  company_name_snapshot       String
  company_vat_number_snapshot String?
  company_address_snapshot    String?
  /// The TRADING name as it stood at issue. Frozen for the same reason every other snapshot here is:
  /// a garage that rebrands must not have every historical document reprint under the new name — an
  /// invoice is a record of what the customer received, not a view of who the garage is today. Same
  /// failure shape as a labour rate revaluing closed months.
  ///
  /// NULL is TEMPORAL and honest: rows issued before this column existed genuinely carried no
  /// trading name, and the renderer falls back to company_name_snapshot for them rather than
  /// pretending. It is not "a caller forgot" — the mint always writes it now.
  company_trading_name_snapshot String?
  customer_name_snapshot      String
  customer_address_snapshot   String?
  /// ── THE PARTY THE DOCUMENT IS ADDRESSED TO, WHEN IT IS NOT THE CUSTOMER ──────────────────────
  /// NULL = billed to the customer, and that is the honest answer for the whole back catalogue as
  /// well as for nearly every invoice raised since. NOT backfilled: an empty string here would say
  /// "billed to an account with no name", which is a different and untrue claim.
  ///
  /// Deliberately a SECOND PAIR rather than an overload of the two columns above. Those mean the
  /// person whose car it is on 3,395 existing documents; writing a company into them would restate
  /// every one of those retrospectively, and the invoice list's Customer column would show people
  /// for some rows and companies for others with nothing to tell them apart.
  account_name_snapshot       String?
  /// NULL when the account had no address recorded. Never the customer's own — see Customer.
  account_address_snapshot    String?
  /// ── THE CAR, AS THE DOCUMENT NAMED IT ────────────────────────────────────────────────────────
  /// Each says its own meaning ON ITS OWN LINE, deliberately. These three carried no explanation at
  /// all until 2026-09-03: they satisfied nullable-annotation-gate only while a NEIGHBOURING
  /// column's comment happened to fall inside its four-line window, and inserting a column above
  /// them revealed it. A shared block above the group would recreate exactly that fragility.
  vehicle_reg_snapshot        String? // NULL = no registration on the card at issue (a counter parts sale has none)
  vehicle_desc_snapshot       String? // NULL = make and model both unknown; "we did not know", never "it has none"
  vehicle_vin_snapshot        String? // NULL = no VIN recorded — usual on a hand-typed vehicle with no lookup
  vehicle_mileage_snapshot    Int? // odometer_in at issue (falls back to mileage_at_create); NULL = no reading taken
  vat_registered_at_issue     Boolean
  created_at                  DateTime @default(now())

  group          Group               @relation(fields: [group_id], references: [id], onDelete: Cascade)
  site           Site                @relation(fields: [site_id], references: [id], onDelete: NoAction)
  job_card       JobCard             @relation(fields: [job_card_id], references: [id], onDelete: NoAction)
  lines          InvoiceLine[]
  payment_method PaymentMethod?      @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  payments       Payment[]
  magic_links    CustomerMagicLink[]

  @@unique([group_id, series, sequence_value]) // no duplicate sequence per tenant per series
  // THE DATABASE IS THE BACKSTOP against double-posting an imported invoice. commit.ts also
  // checks at runtime, but two concurrent commits could both pass that check and both write;
  // only a constraint makes it impossible. NULL external_ref is exempt (Postgres), so ordinary
  // GreaseDesk invoices are unaffected.
  @@unique([group_id, external_ref])
  @@index([group_id])
  @@index([site_id])
  credit_notes CreditNote[]

  /// ── WHAT THE CAR ALSO NEEDED, AS PRINTED ──────────────────────────────────────────────────────
  /// A frozen TEXT BLOCK, not a relation, and frozen for the same reason every other snapshot here
  /// is: an invoice is a record of what the customer RECEIVED. Closing a due item in October must
  /// not alter June's invoice, and a reprint must reproduce the page that was handed over.
  ///
  /// It merges two kinds of fact and BOTH have to freeze:
  ///   • captured findings — a live relation would change as items are closed or added;
  ///   • the MOT EXPIRY, which is DVSA-sourced and MOVES the moment the car is retested. Reading it
  ///     live would print next year's MOT date against last year's invoice — the subtler of the two
  ///     and the reason this is a text block rather than a join.
  ///
  /// NULL on every invoice minted before this existed, and on any card whose vehicle had nothing to
  /// say. Honest-null: no block was captured, as distinct from a block that was empty.
  due_items_snapshot String?
  /// WHAT THIS VISIT SORTED — findings closed as `fixed` on this card, frozen at issue like the
  /// advisories beside them. NULL means nothing was sorted, which is most visits.
  work_done_snapshot String?
  /// WHAT WE MEASURED — tread depths and the battery reading, frozen at issue. NULL on an invoice
  /// minted before 2026-08-21 means the three categories were written as ONE block in
  /// due_items_snapshot; that is how a renderer tells the shapes apart, so it is never backfilled.
  measured_snapshot String?
}

model InvoiceLine {
  cost_basis        String? // 'actual' | 'estimated' — provenance of unit_cost on an imported line
  id                String    @id @default(uuid())
  invoice_id        String
  description       String
  qty               Decimal   @default(1) @db.Decimal(12, 2)
  unit_price        Decimal   @default(0) @db.Decimal(12, 2)
  vat_rate          Decimal   @default(0) @db.Decimal(5, 2)
  line_vat          Decimal   @default(0) @db.Decimal(12, 2)
  line_total        Decimal   @default(0) @db.Decimal(12, 2) // EX-VAT (qty×unit_price); gross = line_total + line_vat
  // INTERNAL — margin only; NEVER rendered to the customer. NULLABLE (2026-07-17): null = cost
  // UNKNOWN (frozen from an un-catalogued ad-hoc part); a number (incl. 0 = free) = known. The P&L
  // EXCLUDES null from parts-cost and surfaces the exposure — never counts unknown as zero.
  unit_cost         Decimal?  @db.Decimal(12, 2)
  labour_hours      Decimal?  @db.Decimal(6, 2) // frozen labour-content grain (fixed-service lines)
  // Frozen classification (freeze-at-issue model): the ledger reads THESE, never the mutable card.
  // Nullable only for pre-backfill legacy rows; every new snapshot writes both.
  item_type         ItemType?
  labour_outsourced Boolean   @default(false)
  catalogue_item_id String? // forward hook; NO FK yet (no catalogue table) — added when catalogue lands
  position          Int       @default(0)
  created_at        DateTime  @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
}

// OCR SHADOW RUN (2026-07-13, fortnight floor trial): one row per engine attempt on every
// slot='vin' photo, logged AFTER the outbox drains it. OFFERS NOTHING — no UI reads this table.
// The trial's one number: proportion of vin photos whose checksum-valid candidate MATCHED the
// VIN a human subsequently typed (join candidates → Vehicle.vin at analysis time).
model VinReadShadow {
  id                String   @id @default(uuid())
  group_id          String
  photo_id          String
  job_card_id       String
  engine            String // 'ocr' | 'haiku' | 'skipped' | 'error:<engine>'
  candidates        Json? // [{ c, valid, source: 'raw'|'normalised' }]
  checksum_valid    Boolean  @default(false) // any candidate passed lib/vin
  latency_ms        Int      @default(0)
  cost_microdollars Int? // engine cost estimate in µ$ (Vision flat ~1500; Haiku from usage)
  created_at        DateTime @default(now())

  @@index([photo_id])
  @@index([group_id, created_at])
}

/**
 * MONEY THAT ACTUALLY ARRIVED. One row per receipt of funds, whatever the route.
 * ── WHY THIS EXISTS ─────────────────────────────────────────────────────────────────────────────
 * Payment used to BE the invoice: status `paid`, one date, one method, and (since 2026-08-12) one
 * amount. That works until an invoice is corrected after payment, or paid in two parts, or refunded
 * — none of which a scalar on Invoice can express. "£120.00 received, £60.00 outstanding" is a
 * sentence a garage says every week and the model could not hold it.
 * ── ONE LEDGER, NOT TWO ─────────────────────────────────────────────────────────────────────────
 * Cash and bank transfers write rows here too (`provider: 'manual'`). A separate Stripe-only table
 * would mean every reader asking two questions and eventually asking only one of them.
 * ── Invoice.amount_paid_pennies BECOMES A CACHE ─────────────────────────────────────────────────
 * Σ succeeded payments − Σ refunds, reconciled in the same transaction that writes either. It stays
 * a column because a dozen readers want it cheaply; it stops being a source of truth.
 * Idempotency copies CommissionEntry, which already models money events correctly: `source_ref` is
 * the natural key of the thing that caused the row, so a redelivered webhook writes once.
 */
model Payment {
  id         String  @id @default(uuid())
  group_id   String
  invoice_id String
  /// NOT NULL, and deliberately so. A denormalisation of Invoice.site_id — which is non-nullable,
  /// on an invoice every payment is required to have. A null could only mean a caller forgot; one
  /// did, and it cost 27% of an August out of the revenue tile. Readers still scope through the
  /// INVOICE (lib/payments::receivedInPeriod), because the copy can drift even when it is present.
  site_id    String

  /**
   * 'stripe' | 'manual' — how the money arrived, not what the garage called it.
   */
  provider String @default("manual")
  /**
   * 'succeeded' | 'processing' | 'requires_action' | 'failed' | 'canceled'.
   * Only `succeeded` counts towards the cache. A card payment has a lifecycle; cash does not, and
   * arrives as `succeeded`.
   */
  status   String @default("succeeded")

  /**
   * What arrived, in pennies. Always positive — a refund is a Refund row, never a negative payment.
   */
  amount_pennies Int
  currency       String @default("GBP")

  // ── Stripe grain. NULL on a manual payment, and NULL is honest there: there was no processor. ──
  payment_intent_id       String? @unique // pi_…
  charge_id               String? // ch_…
  /**
   * Stripe's own processing fee, from the BalanceTransaction. NULL = unknown, never 0.
   */
  stripe_fee_pennies      Int?
  /**
   * Our application fee on this charge. NULL on manual, and NULL when we took none.
   */
  application_fee_pennies Int?
  application_fee_id      String? // fee_…
  /**
   * FROZEN link to the ApplicationFeeRate applied, so what was charged can be explained later.
   */
  fee_rate_id             String?

  // ── The garage's own label for the method, same shape the invoice already carries. ──
  payment_method_id       String?
  payment_method_snapshot String? // name at the time; renames never rewrite history

  /**
   * IDEMPOTENCY. The Stripe event/object id for a real payment; `backfill:<invoice_id>` for a
   * reconstructed one. Unique, so a redelivered webhook is a no-op rather than a double count.
   */
  source_ref String @unique

  /**
   * RECONSTRUCTED, NOT OBSERVED. True for rows the backfill inferred from an invoice that was
   * marked paid before this table existed. The amount is entailed — "paid" meant paid in full,
   * because partial payment did not exist — but nobody typed it, and a row that cannot say so
   * becomes a quiet fabrication in three years.
   */
  reconstructed Boolean @default(false)

  /**
   * When the money arrived (the document fact), not when the row was written.
   */
  collected_at DateTime
  created_at   DateTime @default(now())
  created_by   String? // User.id, or NULL for a webhook / the backfill

  group          Group          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  invoice        Invoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  payment_method PaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  refunds        Refund[]

  @@index([group_id, collected_at])
  @@index([invoice_id])
  @@index([status])
}

/**
 * MONEY GIVEN BACK. Its own row rather than a negative Payment, so "what arrived" and "what was
 * returned" are never summed into a single figure that hides both.
 * ── THE APPLICATION FEE MUST COME BACK TOO ──────────────────────────────────────────────────────
 * Stripe does NOT refund the platform fee automatically: refund a job without
 * `refund_application_fee: true` and the GARAGE loses our cut on money they have handed back.
 * `application_fee_refunded_pennies` records what actually came back so that failure is visible in
 * the data rather than only on their statement.
 */
model Refund {
  id         String @id @default(uuid())
  group_id   String
  payment_id String

  amount_pennies                   Int // positive; the amount returned to the customer
  currency                         String  @default("GBP")
  reason                           String?
  refund_id                        String? @unique // re_…
  /**
   * What Stripe actually returned of our fee. NULL on a manual refund; 0 means we kept it.
   */
  application_fee_refunded_pennies Int?

  source_ref String @unique // Stripe refund id, or 'manual:<uuid>'

  /**
   * WHEN THE MONEY MOVED — the same word Payment uses for the same idea, so nobody has to learn two
   * vocabularies for one concept.
   * ── WHY IT IS NOT created_at ────────────────────────────────────────────────────────────────
   * On the card path these look redundant and did for months: the webhook writes the row seconds
   * after Stripe moves the money, so the two agree to the second and one of them looks spare. They
   * are not the same fact. A garage handing £25 back out of the till on Friday and recording it on
   * Tuesday moved the money on FRIDAY, and this is a VAT-relevant date — filing it on Tuesday puts
   * it in the wrong period. created_at is when WE learned; collected_at is when it HAPPENED.
   * Card refunds take it from the Stripe refund's own `created`, not from when the webhook landed.
   */
  collected_at DateTime

  /**
   * HOW it went back — cash from the till, bank transfer, or the card it came in on. Mirrors
   * Payment exactly, including the snapshot: a renamed method must never rewrite history. NULL on
   * a card refund, where the method is not the garage's to choose.
   */
  payment_method_id       String?
  payment_method_snapshot String?

  created_at DateTime @default(now())
  created_by String?

  group          Group          @relation(fields: [group_id], references: [id], onDelete: Cascade)
  payment        Payment        @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  payment_method PaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)

  @@index([group_id, created_at])
  // Period questions ask WHEN THE MONEY MOVED, so they index on that — same as Payment.
  @@index([group_id, collected_at])
  credit_notes CreditNote[]
}

model PaymentMethod {
  id         String           @id @default(uuid())
  group_id   String
  name       String
  behaviour  PaymentClearance @default(windowed)
  active     Boolean          @default(true)
  position   Int              @default(0)
  created_at DateTime         @default(now())

  group    Group     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments Payment[]
  refunds  Refund[]

  @@index([group_id])
}

model InvoiceSequence {
  group_id              String   @id // one row per tenant
  last_value            Int      @default(0) // CHARGEABLE counter — monotonic, never resets, never reused. Seedable in settings ONLY while no chargeable invoice exists.
  warranty_last_value   Int      @default(0) // WARRANTY counter — same guarantees, fully independent (a comeback never burns a chargeable number).
  // HISTORICAL counter — the third independent series. Recording an invoice raised elsewhere must
  // never advance the chargeable counter; that is the whole reason this column exists.
  historical_last_value Int      @default(0)
  /// CREDIT NOTE counter — the FOURTH, and independent for the same reason the historical one is:
  /// a VAT correction is its own document with its own series, and issuing one must never advance
  /// the chargeable counter. HMRC VATREC13040 requires a credit note to carry its own identifying
  /// number; sharing the invoice sequence would make the two indistinguishable in the series.
  credit_note_last_value Int     @default(0)
  updated_at            DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

// ───────────────────────────────────────────────────────────────────────────────
// Product catalogue — a grain-standardiser + data-entry accelerator (NOT stock control). Defined
// once per tenant (code → cost/price/VAT/type); typing the code on a job-card line pre-fills it as
// editable defaults. Carries BOTH cost and price so margin is banked at entry.
// ───────────────────────────────────────────────────────────────────────────────

model CatalogueItem {
  id                String   @id @default(uuid())
  group_id          String // TENANT-level — one shared catalogue, one price, across all sites
  code              String // required; unique per tenant; the match key
  // Human label shown in "choose a service" pickers (distinct from code=reference and the printed
  // spec). Backfilled = code for existing rows; consumers show `title || code` so it's never blank.
  title             String?
  name              String // fills the line's description on autocomplete
  item_type         ItemType // labour | part | misc | fixed
  // Simple items (part/labour/misc): flat cost + price. Fixed items: these are MIRRORED derived-on-
  // save from base_price_ex_vat + the component sum (see lib/catalogue.ts) — never set by callers.
  // NULLABLE (2026-07-23): null = cost NOT ENTERED (flagged uncosted in Products; a null freezes onto
  // the sold line); a number (incl. 0 = legitimately free) = known. Same null/zero discipline as
  // InvoiceLine/JobCardItem. Fixed services mirror Σ component cost — a number when any component
  // exists, null when none. Readers MUST treat null as UNKNOWN, never as 0.
  unit_cost         Decimal? @db.Decimal(12, 2)
  unit_price        Decimal  @db.Decimal(12, 2)
  vat_rate          Decimal  @default(20) @db.Decimal(5, 2) // defaulted from getTenantVat().defaultRate on create
  active            Boolean  @default(true) // archive (false) preferred over hard delete — preserves history
  // Fixed-price services only: the anchor/lowest-tier EX-VAT price (null for simple items).
  base_price_ex_vat Decimal? @db.Decimal(12, 2)
  // Notional labour CONTENT of a fixed-price service (charged hours). NOT booking duration, NOT
  // actual worked hours (clocking is banked). Inherited by each job line using the service.
  labour_hours      Decimal? @db.Decimal(6, 2)
  // Bought-in labour/services (MOT, Star clutch): cost of sale via components, marked up,
  // INVISIBLE to utilisation — labour_hours stays the CUSTOMER-BILLED hours (prices the job)
  // but never enters the charged-hours numerator or the missing-hours amber.
  labour_outsourced Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  group         Group                    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  job_lines     JobCardItem[]
  components    CatalogueComponent[]
  tier_prices   CatalogueItemTierPrice[]
  promo_targets PromoTarget[]
  aliases       CatalogueAlias[]

  @@unique([group_id, code])
  @@index([group_id])
}

// Tenant-DEFINED, OPTIONAL vehicle/price tiers (0 tiers = single-price world; no tier UI shown).
model ServiceTier {
  id         String   @id @default(uuid())
  group_id   String
  name       String
  position   Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  group       Group                    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  tier_prices CatalogueItemTierPrice[]

  @@index([group_id])
}

// A fixed service's cost/spec components. NEVER a priced customer row — only descriptions
// concatenate into the invoice line's spec; qty×unit_cost feeds the item's true cost.
model CatalogueComponent {
  id                String  @id @default(uuid())
  catalogue_item_id String
  description       String
  qty               Decimal @default(1) @db.Decimal(12, 2)
  unit_cost_ex_vat  Decimal @default(0) @db.Decimal(12, 2)
  position          Int     @default(0)

  item CatalogueItem @relation(fields: [catalogue_item_id], references: [id], onDelete: Cascade)

  @@index([catalogue_item_id])
}

// Per-tier published price override. Three states: no row → inherit base_price; value → that price;
// null price_ex_vat → OFFERED at this tier but price set per-job (manual on the card picker).
model CatalogueItemTierPrice {
  id                String   @id @default(uuid())
  catalogue_item_id String
  tier_id           String
  price_ex_vat      Decimal? @db.Decimal(12, 2)

  item CatalogueItem @relation(fields: [catalogue_item_id], references: [id], onDelete: Cascade)
  tier ServiceTier   @relation(fields: [tier_id], references: [id], onDelete: Cascade)

  @@unique([catalogue_item_id, tier_id])
  @@index([catalogue_item_id])
  @@index([tier_id])
}

// Reusable discount codes ("promotions"). VAT-aware: `amount` is entered/advertised INC-VAT for a
// fixed promo (£ off) or is the percentage for a percentage promo. Applied on an estimate as ONE
// negative EX-VAT part line via the existing discount mechanism (the VAT split falls out of the
// aggregate recompute in lib/quote-totals). A promo is NOT sellable — its own section, not a product.
enum PromoType {
  fixed // amount = £ off, INC-VAT
  percentage // amount = percent off the inc-VAT total at apply-time
}

model Promo {
  id         String    @id @default(uuid())
  group_id   String // TENANT-level — one shared promo list across all sites
  code       String // short code / match key, unique per tenant (e.g. "BMW50")
  label      String // human label shown on the discount line ("10% off")
  promo_type PromoType
  amount     Decimal   @db.Decimal(12, 2) // fixed: £ inc-VAT; percentage: the percent (e.g. 10.00)
  active     Boolean   @default(true) // archive (false) preferred over delete — keeps history legible
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  group   Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  targets PromoTarget[] // for a percentage promo: the catalogue items it applies to

  @@unique([group_id, code])
  @@index([group_id])
}

// A percentage promo's targeted products — the estimate matches these catalogue ids to job lines
// (via JobCardItem.catalogue_item_id) so the % discounts only the covered services, each keeping its
// own VAT treatment. Fixed-£ promos ignore targets (whole-job discount).
model PromoTarget {
  id                String @id @default(uuid())
  promo_id          String
  catalogue_item_id String

  promo Promo         @relation(fields: [promo_id], references: [id], onDelete: Cascade)
  item  CatalogueItem @relation(fields: [catalogue_item_id], references: [id], onDelete: Cascade)

  @@unique([promo_id, catalogue_item_id])
  @@index([promo_id])
  @@index([catalogue_item_id])
}

// ───────────────────────────────────────────────────────────────────────────────
// Cost-capture (per-site P&L foundation) — raw grains only, no aggregation here.
// Every cost (person or overhead) is allocated across one+ sites by percent (Σ=100%).
// The 100%-sum + tenant-site invariant is enforced in lib/cost-allocation.ts (the one place).
// ───────────────────────────────────────────────────────────────────────────────

// Headcount = people-as-costs, independent of User (a temp/bottle-washer costs money without a
// login). Optional user_id links a cost to a real login later; costs ≠ logins.
model CostPerson {
  id             String   @id @default(uuid())
  group_id       String
  name           String
  role           String? // free-text ("Master Tech", "Bottle washer")
  cost_type      CostType
  amount_pennies Int // salary (annual) OR hourly rate, in pennies
  user_id        String?  @unique
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  // --- CAPACITY MODEL (utilisation denominator) ---
  // is_chargeable marks "turns spanners" — deliberately NOT User.role (a manager can be
  // chargeable) and default FALSE so non-productive staff never inflate capacity.
  // contracted_hours_per_day: NULL on a chargeable person = incomplete config (amber flag).
  // working_days: rostered weekdays (0=Sun..6=Sat); EMPTY = inherit the site's open_days
  // (TMBS default Mon–Sat) — an explicit value overrides.
  is_chargeable                  Boolean   @default(false)
  contracted_hours_per_day       Decimal?  @db.Decimal(4, 2)
  working_days                   Int[]     @default([])
  // Annual leave allowance in DAYS (per person, admin-editable). Leave-year = CALENDAR year in
  // v1: "taken" = this calendar year's leave rows, balance = allowance − taken. SEAM (banked):
  // configurable leave-year start + carry-over + part-time/six-day pro-rata would land here.
  // Allowance/balance are PER-PERSON figures — never apportioned or summed across sites.
  annual_leave_allowance_days    Decimal?  @default(28.0) @db.Decimal(4, 1)
  // Utilisation factor (%): the REALISTIC share of this person's available hours that can
  // be billed — sets the workshop's derived target; NEVER an individual performance score.
  // NOT NULL (default 70 — a competent full-time mechanic) so the target can't break.
  // Effective-dated via EmploymentEvent kind `factor`; the TARGET resolves value-at-window-end
  // from the series (the first value-true-at-time read — historic months keep their factor).
  utilisation_factor             Int       @default(70)
  // --- EMPLOYMENT DATES: TWO AT EACH END, because work and pay do not have to stop together ---
  // Payment in lieu of notice is the case a single leaving date cannot express: the last day
  // someone turns spanners and the last day they are paid can be a month apart, and each drives a
  // DIFFERENT figure. `work_*` drives CAPACITY (they generate no sellable hours after it);
  // `pay_*` drives COST (the P&L still carries them). One clause reads both —
  // lib/capacity `employedDuring(groupId, window, basis)` — so the rule is never written twice.
  //
  // ASYMMETRIC BY DESIGN AT THE START (ruling 2026-08-02): both columns exist so the clause is
  // uniform at both ends, but the hiring form asks for ONE date and defaults the payroll start to
  // it (editable behind a disclosure). Pay preceding work effectively does not happen; demanding a
  // second date on every hire produces a field where both values are always identical.
  //
  // A NULL pay_* means the payroll date COINCIDES with the work date — a stated default, NOT
  // unknown. A NULL work_start_date (`start_date`) IS unknown: it is included in the window and
  // the person is named in `unknownStartPeople`, never silently counted.
  // `is_active` is deliberately NOT part of the employment window: it is a current-state flag, and
  // answering a historic question with it deleted a leaver's capacity and cost from months they
  // demonstrably worked. It belongs to the HR current-employees list and the roster's live view.
  // DEPRECATED, retained deliberately: renaming it in place would have broken the LIVE dashboard
  // for the minutes between `migrate deploy` and the new deployment being promoted — the old code
  // still selects it. Nothing reads it; it is all-null across every tenant and drops in a
  // follow-up migration once no running build references it.
  end_date                       DateTime?
  // --- PERSONAL DETAILS. All OPTIONAL, none defaulted, none effective-dated ---------------------
  // NOT EventS: EmploymentEvent exists because a PAST month's figure must not restate when a value
  // changes (pay, hours, pattern, factor). Nothing here feeds capacity, cost or VAT, and an address
  // change is a CORRECTION of a current fact rather than a new value that was true from a date —
  // the same reasoning already recorded for start_date.
  //
  // These live on CostPerson, not User, because User is "people who log in" and CostPerson is
  // "people you employ" — and NOT ONE CostPerson in either live tenant is linked to a User, so the
  // equivalent User columns are unreachable from HR. personal_email is a SEPARATE column from
  // User.email deliberately: that one is a @unique credential, this one is contact data that two
  // people may legitimately share.
  date_of_birth                  DateTime? @db.Date
  home_address                   String?
  personal_email                 String?
  personal_phone                 String?
  emergency_contact_name         String?
  emergency_contact_relationship String?
  emergency_contact_phone        String?
  // UNSELECTED BY DEFAULT, both of them. Null means "not asked / not answered" and must never be
  // rendered as a guess. Neither is Article 9 data on its own — the Art 9(1) list does not include
  // gender identity — but together they can REVEAL gender reassignment and therefore health, so
  // they are handled as if they were: optional, explained at the point of entry, never inferred.
  gender                         String?
  pronouns                       String?
  start_date                     DateTime? // first WORKING day (see above)
  pay_start_date                 DateTime? // NULL = same as start_date
  work_end_date                  DateTime? // last WORKING day — capacity stops here
  pay_end_date                   DateTime? // last PAID day — cost stops here. NULL = same as work_end_date

  group            Group             @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  allocations      CostAllocation[]
  leave            LeaveRecord[]
  employmentEvents EmploymentEvent[]

  @@index([group_id])
}

// --- Leave (capacity subtraction). PER-DAY rows by design: clean month attribution, no
// range-splitting math. hours NULL = the person's full rostered day at read time (stays correct
// if contracted hours later change); an explicit value = part-day (validated ≤ contracted).
// Leave only subtracts when the date is a ROSTERED day — a Sunday entry subtracts nothing.
// status defaults approved: the manager IS the write path in v1 (mechanic self-service
// request→approve is banked — adding a `requested` enum value + transitions is additive).
// Allowance rule lives in lib/leave-types DEDUCTS_ALLOWANCE (single source): only annual +
// closure consume the grant; the rest are capacity-affecting but allowance-neutral.
enum LeaveType {
  annual
  sick
  other
  closure // company-mandated closure (e.g. Christmas shutdown) — REAL pre-booked leave rows that
  // consume the allowance AND drop capacity (binding model: allowance = FULL grant;
  // closures are never modelled as a reduced allowance). Visually distinct in the Roster.
  compassionate
  parental
  training
}

enum LeaveStatus {
  approved
}

model LeaveRecord {
  id             String      @id @default(uuid())
  group_id       String
  cost_person_id String
  site_id        String // attribution site (a split-allocation mechanic's leave is booked where taken)
  date           DateTime // day-grained (UTC midnight)
  hours          Decimal?    @db.Decimal(4, 2) // NULL = full rostered day
  // Rows created in ONE range booking share a batch id — displayed/edited/deleted as one unit.
  // NULL = legacy/single ad-hoc row. Storage stays per-day (clean month/year attribution).
  leave_batch_id String?
  type           LeaveType   @default(annual)
  status         LeaveStatus @default(approved)
  created_by     String? // user id (audit convenience; writeAudit rows carry the trail)
  created_at     DateTime    @default(now())

  group       Group      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  cost_person CostPerson @relation(fields: [cost_person_id], references: [id], onDelete: Cascade)
  site        Site       @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@unique([cost_person_id, date]) // one row per person-day (no double-subtraction)
  @@index([leave_batch_id])
  @@index([group_id, site_id, date])
}

// Manual public-holiday list (v1 — auto-derive from Site.locale banked). Group-scoped;
// site_id NULL = applies to ALL the group's sites (both TMBS sites share England & Wales
// bank holidays); set site_id for a region-specific site later. Subtracts a full rostered
// day from every chargeable mechanic whose roster includes that weekday.
// HR effective-dated employment history (RECORD-FIRST): the flat CostPerson columns stay the
// HEAD of each series and every compute keeps reading them; events are the append-only log.
// kind buckets one field-family each; value_json/previous_json carry {…} shaped per kind.
enum EmploymentEventKind {
  wage // { amount_pennies, cost_type }
  hours // { contracted_hours_per_day }
  pattern // { working_days } — 4e superseded: college windows = paired pattern events
  chargeable // { is_chargeable }
  allowance // { annual_leave_allowance_days }
  started // { start_date }
  ended // { work_end_date, pay_end_date, reason } — mark-as-left (is_active=false in the same tx).
  // The reason is FREE TEXT and OPTIONAL: a mandatory reason becomes a field full of "x".
  name // { name } — a surname change is HR history, not a silent overwrite
  factor // { utilisation_factor } — workshop expectation %, effective-dated (target reads value-at-time)
  role // { role } — the 80/20 of role progression (full position-management stays its own build)
}

model EmploymentEvent {
  id              String              @id @default(uuid())
  group_id        String
  cost_person_id  String
  kind            EmploymentEventKind
  // Admin-picked (defaults today; far-past/future needs an explicit confirm — never silent).
  // ORDERING ASSUMPTION for the banked value-true-at-time read: "value at T" = the latest event
  // of this kind with effective_date <= T (created_at breaks ties). Back-dating an event BEFORE
  // an existing one therefore INSERTS history — it governs only the gap up to the next event's
  // effective_date and never changes the head; the flat column remains current-state truth.
  effective_date  DateTime
  value_json      Json
  previous_json   Json?
  changed_by      String? // user id (the audit who; created_at is the when)
  created_at      DateTime            @default(now())
  // Corrections (admin-only, themselves recorded): a REDATE updates effective_date in place and
  // appends {at, by, from, to} here (array — repeat corrections stack); a VOID keeps the row
  // visible (struck through) but EXCLUDED from any value-at-time read — the ordering rule above
  // therefore reads "latest NON-VOIDED event of kind K with effective_date ≤ T".
  correction_json Json?
  voided_at       DateTime?
  voided_by       String?

  group       Group      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  cost_person CostPerson @relation(fields: [cost_person_id], references: [id], onDelete: Cascade)

  @@index([cost_person_id, kind, effective_date])
  @@index([group_id, created_at])
}

enum SiteConfigEventKind {
  open_days // { open_days: Int[] } — trading days; changing them changes HISTORICAL capacity
  hours // { open_hour, close_hour } — reserved; no event needed while times are unchanged
  breaks // { breaks } — reserved
}

// Effective-dated Site configuration — the EmploymentEvent pattern, applied to the site.
//
// WHY: open_days is a single current value, so every historical window was computed against
// TODAY's trading pattern. Great Bridge traded Mon–Sat until 2026-04-01 and Mon–Fri after, which
// meant any pre-April period silently understated capacity for anyone inheriting the site pattern.
//
// The flat Site columns REMAIN current-state truth and the resolver's final fallback (exactly as
// CostPerson keeps its flat columns beside EmploymentEvent). This table records the CHANGES.
// One event at the change date represents BOTH eras: value_json after, previous_json before —
// see openDaysAtWindowEnd for the resolution rule.
model SiteConfigEvent {
  id              String              @id @default(uuid())
  group_id        String
  site_id         String
  kind            SiteConfigEventKind
  effective_date  DateTime
  value_json      Json
  previous_json   Json?
  changed_by      String? // user id (the audit who; created_at is the when)
  created_at      DateTime            @default(now())
  // Corrections, mirroring EmploymentEvent: a VOID keeps the row visible but EXCLUDED from any
  // value-at-time read; the resolver filters voided_at: null.
  correction_json Json?
  voided_at       DateTime?
  voided_by       String?

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  site  Site  @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@index([site_id, kind, effective_date])
  @@index([group_id, created_at])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// INVOICE IMPORT — staging. STAGING IS NEVER THE LEDGER.
// Uploaded PDFs parse into these tables and are edited here; only an explicit commit drives the
// app's OWN write paths (jobcard create -> place -> stages -> issueInvoiceForCard -> mark paid).
// There is no second write path into the ledger, and nothing here is read by any financial report.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

enum ImportBatchStatus {
  open // accepting uploads / in progress
  committing // whole-month commit under way
  committed // every invoice resolved
  abandoned
}

enum StagedInvoiceStatus {
  pending // parsed, untouched
  in_progress // being worked in the wizard (resumable across sessions)
  committed // written to the ledger; job_card_id + invoice_id set
  skipped // deliberately not imported; skip_reason required
}

model ImportBatch {
  id         String            @id @default(uuid())
  group_id   String
  site_id    String
  label      String // e.g. "TMBS May 2026"
  source     String            @default("xero_pdf")
  status     ImportBatchStatus @default(open)
  created_by String?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  group    Group           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  site     Site            @relation(fields: [site_id], references: [id], onDelete: Cascade)
  invoices StagedInvoice[]

  @@index([group_id, status])
}

model StagedInvoice {
  id       String @id @default(uuid())
  batch_id String
  group_id String

  external_number  String // the Xero number, e.g. 100002292 — carried to Invoice.external_ref
  issue_date       DateTime // the PRINTED date; immutable, never shifted
  registration     String?
  // Customer name as PARSED from the invoice's address block, then EDITABLE by the operator.
  // 24 of TMBS's 42 May invoices carry only a first name ("Angi - BG63APU"), which is too thin an
  // identity to create a customer from — so where the vehicle is new the operator types the full
  // name before commit. Where the registration matches an existing vehicle the customer comes from
  // the ownership edge and this is a CROSS-CHECK only. (No phone: 0/42 PDFs contain one.)
  customer_name    String?
  // RECONCILIATION IS A HARD COMMIT GATE: parsed line amounts must equal the printed Subtotal.
  subtotal_printed Decimal  @db.Decimal(12, 2)
  subtotal_parsed  Decimal  @db.Decimal(12, 2)
  reconciled       Boolean  @default(false)
  // VAT is COMPUTED through lib/tax.computeTax, never taken from the PDF. A variance is surfaced,
  // not absorbed — at least one May invoice carries a discount entered VAT-inclusive.
  vat_printed      Decimal? @db.Decimal(12, 2)
  // The printed GROSS. Captured at ingest so the post-commit assertion can compare what was WRITTEN
  // against all three printed figures, not just the subtotal the reconciliation gate checks.
  total_printed    Decimal? @db.Decimal(12, 2)
  vat_computed     Decimal? @db.Decimal(12, 2)

  // The diary date is EDITABLE per card and defaults to issue_date; the invoice keeps its printed
  // date immutably. Weekend-dated invoices are placed on a working day of the operator's choosing —
  // nothing is shifted automatically.
  planned_start_at        DateTime?
  planned_resource_id     String?
  // WORKING minutes for the diary placement. Was hardcoded to 60 at commit, so every imported card
  // occupied exactly one hour whatever the job — silently wrong occupancy on every commit, and a
  // contradiction of the duration-is-source-of-truth rule. Null falls back to the seeded suggestion.
  planned_working_minutes Int?

  status      StagedInvoiceStatus @default(pending)
  skip_reason String?
  wizard_step Int                 @default(1)

  job_card_id String? // set on commit
  invoice_id  String? // set on commit
  raw_text    String? @db.Text // the extracted layer, kept for audit of what was parsed

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  batch ImportBatch  @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  lines StagedLine[]

  @@unique([group_id, external_number])
  @@index([batch_id, status])
}

model StagedLine {
  id                String @id @default(uuid())
  staged_invoice_id String
  position          Int

  description       String
  continuation_text String? @db.Text // verbatim; describes the operations actually performed
  qty               Decimal @db.Decimal(12, 4)
  unit_price        Decimal @db.Decimal(12, 4) // 4dp: Xero prints 133.3333
  vat_text          String? // "20%" | "No VAT" | blank — recorded, NOT trusted for tax
  amount            Decimal @db.Decimal(12, 2) // negatives arrive parenthesised: (1,537.37)

  // Operator-supplied, resolved from line memory where known.
  kind              ItemType? // labour | part | misc | fixed
  catalogue_item_id String?
  parts_cost        Decimal?  @db.Decimal(12, 2)
  labour_hours      Decimal?  @db.Decimal(6, 2)
  cost_basis        String? // 'actual' | 'estimated'
  is_adjustment     Boolean   @default(false) // negative line: cost 0.00, never prompts

  // ── SPLIT: a bundled line broken into its constituents ─────────────────────────────────────
  // "Supply and fit 2 x front wheel bearing" @ 2 x 133.3333 is parts AND labour in one figure.
  // Children carry the breakdown (a parts line with its own catalogue item, a labour line with
  // hours); the PARENT remains exactly as printed and is what reconciles to the Subtotal.
  //
  // HARD INVARIANT: sum(children.amount) == parent.amount, to the penny. Enforced when a split is
  // saved AND again at commit. The invoice the customer holds is the truth; a split may re-express
  // it but must never change it. Splitting is OPTIONAL — an unsplit line commits as itself.
  parent_line_id String?
  parent         StagedLine?  @relation("LineSplit", fields: [parent_line_id], references: [id], onDelete: Cascade)
  children       StagedLine[] @relation("LineSplit")

  staged_invoice StagedInvoice @relation(fields: [staged_invoice_id], references: [id], onDelete: Cascade)

  @@index([staged_invoice_id, position])
  @@index([parent_line_id])
}

// A split, remembered so it can be re-offered. Same key as CatalogueAlias (description +
// unit_price), and applied RETROACTIVELY across pending staged lines exactly as an alias is:
// deciding how to break a bundle down once settles every later occurrence in the batch.
model LineSplitTemplate {
  id            String   @id @default(uuid())
  group_id      String
  description   String
  unit_price    Decimal? @db.Decimal(12, 4)
  // [{ description, qty, unit_price, kind, catalogue_item_id, parts_cost, labour_hours }]
  children_json Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, description, unit_price])
}

// LINE MEMORY — the seed of the catalogue, not a throwaway import table.
// Keyed on description + unit_price because the SAME description at a different price is a
// DIFFERENT job (engine tiers: "Change Oil using 100% Synthetic engine oil" at 125 / 165 / 233.33).
// Aliasing lets differently-typed variants resolve to one canonical CatalogueItem.
model CatalogueAlias {
  id                String   @id @default(uuid())
  group_id          String
  catalogue_item_id String
  description       String
  unit_price        Decimal? @db.Decimal(12, 4) // null = matches at any price
  source            String   @default("import") // 'import' | 'manual'
  created_at        DateTime @default(now())

  group Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  item  CatalogueItem @relation(fields: [catalogue_item_id], references: [id], onDelete: Cascade)

  @@unique([group_id, description, unit_price])
  @@index([catalogue_item_id])
}

model PublicHoliday {
  id         String   @id @default(uuid())
  group_id   String
  site_id    String? // NULL = all sites
  date       DateTime // day-grained (UTC midnight)
  label      String
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  site  Site? @relation(fields: [site_id], references: [id], onDelete: Cascade)

  @@unique([group_id, site_id, date])
  @@index([group_id, date])
}

// Open-ended, admin-extendable business costs (rent, rates, insurance, IT, phones…).
/// ── A COST, AND ITS OCCURRENCES ────────────────────────────────────────────────────────────────
/// The Overhead register it replaces had NO DATES AT ALL: one amount, normalised to a month and
/// multiplied by the window's month count, so every month of every period carried today's figure.
/// A cost that started in June was charged to January; a rent rise restated a closed year.
///
/// The occurrence (CostInstance) is what every reader reads. The definition carries identity,
/// cadence and the charge rule; the amount lives in an append-only CostRate series so a rise is
/// ONE auditable fact with a date, the shape EmploymentEvent already uses for pay.
model Cost {
  id       String @id @default(uuid())
  group_id String
  name     String

  cadence CostCadence
  charge  CostCharge  @default(spread)

  /// First period this cost applies to. Instances before it are never generated.
  active_from DateTime
  /// Last period, exclusive. NULL = still running — a meaningful absence, not an unset field.
  active_to   DateTime?

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  group       Group            @relation(fields: [group_id], references: [id], onDelete: Cascade)
  rates       CostRate[]
  instances   CostInstance[]
  allocations CostAllocation[]

  @@index([group_id, is_active])
}

/// APPEND-ONLY. A rent rise is a new row with an effective date, never an edit to the old one —
/// the same rule as EmploymentEvent, and for the same reason: what a garage was charged in March
/// is a fact about March and must not move when the rent changes in June.
model CostRate {
  id             String   @id @default(uuid())
  cost_id        String
  effective_from DateTime
  amount_pennies Int
  created_at     DateTime @default(now())

  cost Cost @relation(fields: [cost_id], references: [id], onDelete: Cascade)

  @@unique([cost_id, effective_from])
  @@index([cost_id, effective_from])
}

/// ONE OCCURRENCE. Generated forward, then editable: a variable bill is edited when the real figure
/// arrives, and `is_estimate` says which of those two a reader is looking at.
model CostInstance {
  id      String @id @default(uuid())
  cost_id String

  /// The period this occurrence covers — [period_start, period_end).
  period_start DateTime
  period_end   DateTime
  /// When it actually falls due inside that period. Equals period_start for a monthly cost.
  due_on       DateTime

  amount_pennies Int
  /// Generated from the rate, and not yet confirmed against a real bill.
  is_estimate    Boolean @default(true)

  /// SET BY A HUMAN EDIT, AND THE ONLY THING REGENERATION LOOKS AT. Once somebody types the actual
  /// figure, regeneration must never overwrite it — that would silently restate a closed month.
  /// NULL = nobody has touched this occurrence, so it is still the generated estimate and
  /// regeneration is free to rewrite it. Temporal: every instance starts here.
  edited_at DateTime?
  /// NULL = never edited, in step with edited_at — the two are one fact and are written together.
  edited_by String?

  created_at DateTime @default(now())

  cost Cost @relation(fields: [cost_id], references: [id], onDelete: Cascade)

  @@unique([cost_id, period_start])
  @@index([cost_id, period_start])
  @@index([period_start])
}

model Overhead {
  id                    String         @id @default(uuid())
  group_id              String
  name                  String
  ex_vat_amount_pennies Int // EX-VAT amount = the true cost, entered directly
  vat_rate              Decimal        @default(0) @db.Decimal(5, 2) // per-expense rate (free entry: 5, 0, 20…); pre-filled from Group.default_vat_rate
  period                OverheadPeriod
  is_active             Boolean        @default(true)
  created_at            DateTime       @default(now())

  group       Group            @relation(fields: [group_id], references: [id], onDelete: Cascade)
  allocations CostAllocation[]

  @@index([group_id])
}

// Shared allocation mechanism: one cost → many site allocations. Exactly one owner
// (cost_person_id XOR overhead_id) is enforced by a DB CHECK in the migration. Per-cost
// percents sum to 100.00 (basis-point validation in lib/cost-allocation.ts).
model CostAllocation {
  id             String   @id @default(uuid())
  group_id       String // denormalised tenant guard (indexed by-site pivot)
  site_id        String
  percent        Decimal  @db.Decimal(5, 2) // 0.01–100.00
  /// Exactly ONE of these three owners is set — enforced by CostAllocation_one_owner_chk, which
  /// Prisma cannot express. NULL = this allocation belongs to one of the other two kinds, never
  /// "not filled in": an allocation owned by nothing is a cost apportioned to a subject nobody can
  /// name, and the constraint refuses it.
  cost_person_id String?
  overhead_id    String?
  cost_id        String?
  created_at     DateTime @default(now())

  group       Group       @relation(fields: [group_id], references: [id], onDelete: Cascade)
  site        Site        @relation(fields: [site_id], references: [id], onDelete: Cascade)
  cost_person CostPerson? @relation(fields: [cost_person_id], references: [id], onDelete: Cascade)
  overhead    Overhead?   @relation(fields: [overhead_id], references: [id], onDelete: Cascade)
  cost        Cost?       @relation(fields: [cost_id], references: [id], onDelete: Cascade)

  @@unique([cost_person_id, site_id])
  @@unique([overhead_id, site_id])
  @@unique([cost_id, site_id])
  @@index([group_id])
  @@index([site_id])
  @@index([cost_person_id])
  @@index([overhead_id])
}

// Shared-state rate limiting for unauthenticated auth endpoints (forgot-password). Serverless has
// no usable in-memory state — invocations are cold and concurrent — and there's no Redis/KV in the
// stack, so the DB every request already touches IS the shared store. Append-only; counted over a
// window; pruned opportunistically. `key` is HASHED (email:<sha256>) so this never becomes a
// plaintext list of who asked for a reset. ip:<addr> keys are the second axis.
model AuthRateLimit {
  id         String   @id @default(uuid())
  key        String // 'email:<sha256>' | 'ip:<addr>'
  created_at DateTime @default(now())

  @@index([key, created_at])
}

// ── NOTIFICATION LAYER (slice-1 A) ────────────────────────────────────────────────────────────────
// THE record of every message GreaseDesk sends to a person, written by the ONE chokepoint
// (lib/notify.ts::sendNotification). Provider-agnostic from the start: `channel` says HOW it went,
// `provider` says WHO carried it (resend today, an SMS provider later) — adding SMS is a new adapter
// + config, never a second send path. Status is the provider's answer where it reports one; a
// provider that reports delivery asynchronously (webhook) updates the row by provider_message_id.
//
// PRIVACY: `recipient` is stored in the CLEAR on purpose — unlike AuthRateLimit (which must never
// become a list of who asked for a reset), an operator answering "did my customer get their quote?"
// needs the address. It is tenant-scoped customer data, same tier as Customer.email.
enum NotificationChannel {
  email
  sms
}

/**
 * WHOSE MESSAGE IS THIS? Stated, never inferred from an absent group_id.
 *
 * `group_id IS NULL` used to mean four things at once: a deliberate platform send, an unresolved
 * inbound, a fixture, or A CALLER FORGOT. Nothing told them apart, and three tenant-scoped guards
 * inside sendNotification fail OPEN without a tenant — the demo block, the opt-out check and the
 * SMS allowance — so a forgotten tenant could contact someone who had asked not to be contacted.
 *
 * THREE values, not two: "unresolved" is genuinely different from "platform" — the message was
 * meant for some tenant and we could not work out which. That is the one place honest-null still
 * applies, and it is why this is not a boolean.
 */
enum NotificationScope {
  tenant // a garage's message. group_id IS NOT NULL — enforced by a CHECK constraint.
  platform // from GreaseDesk itself (lib/notify::PLATFORM_SEND). group_id IS NULL, deliberately.
  unresolved // INBOUND only: meant for a tenant, sender not matched. group_id IS NULL, honestly.
}

enum NotificationStatus {
  queued // handed to the provider, no answer yet
  sent // provider accepted it
  failed // provider rejected it, or the transport threw
  delivered // provider later confirmed delivery (webhook)
  bounced // provider later reported a hard bounce (webhook)
  skipped // deliberately not sent (provider unconfigured / no recipient) — recorded, not silent
  received // INBOUND: it arrived. Not 'sent' — we did not send it, and none of the outbound
  // statuses describe a message that came the other way.
}

model NotificationLog {
  id       String              @id @default(uuid())
  /// WHOSE MESSAGE. No default — a default would let the next caller omit it and be believed.
  /// A CHECK constraint pairs this with group_id: tenant ⇒ NOT NULL, platform/unresolved ⇒ NULL,
  /// so a forgotten tenant can no longer masquerade as a deliberate platform send.
  scope    NotificationScope
  // ── group_id NULL IS A RECORD, NOT AN ORPHAN ────────────────────────────────────────────────
  // Two legitimate causes, and BOTH are rows to keep:
  //   • a platform-level send (operator invite, reseller enquiry) — never belonged to a tenant;
  //   • an INBOUND email we could not resolve to a tenant — "unresolved is recorded, never
  //     dropped" is the inbound spine's rule, and this row IS that record.
  // ANY cleanup predicate over this table must exclude NULL explicitly. Treating it as "orphaned"
  // deletes exactly the evidence somebody will need when an email goes missing (learned the hard
  // way, 2026-08-09 — one such row was swept by a teardown that assumed NULL meant stale).
  group_id String?
  channel  NotificationChannel
  template String // template key (lib/notification-templates) — never free-text body
  provider String // 'resend' | 'none' | future sms provider — configuration, not code
  status   NotificationStatus  @default(queued)

  recipient           String // email address or E.164 phone — see PRIVACY note above
  subject             String? // email only
  provider_message_id String? // provider's id, for delivery-webhook reconciliation
  // WHAT THE PROVIDER SAID BACK. The SMS adapter used to discard the response entirely, so a row
  // recorded that we sent something and nothing could ever be reconciled with the provider's own
  // console — no sid, no status, and crucially no record of WHICH SENDER went out. A Messaging
  // Service can silently fall back from the alphanumeric `GreaseDesk` to the bare number, and
  // without this there is no way to know that happened. { sid, status, from, numSegments }.
  provider_meta       Json?
  // WHEN THE PROVIDER TOLD US HOW IT ENDED. Written ONLY by a status callback, never by the send.
  // Its absence is the difference between two claims that otherwise look identical in the field:
  // "we never had a way to know" (any row minted before the callback existed) and "we asked and
  // heard nothing back" (a row the provider has gone quiet on). `status` alone cannot express that.
  status_settled_at   DateTime?
  error               String? // provider/transport error, when status = failed

  // STAFF-COMPOSED BODY. Null for templated sends — there the template key + data ARE the record and
  // the body is reproducible. For a free-text message the words a person chose are the only record
  // of what the customer was told, so they are kept. This does not make the table a free-text log:
  // `template` still names the shape, and only the free_text template populates this.
  body                String?
  // The HTML part of an inbound message, kept beside the text. WE persist the body because Resend
  // discards received mail after 30 DAYS — after that their API cannot answer, so this row is the
  // only copy of what a customer said.
  body_html           String?
  // WHY the body is missing — provider status code and message. A SEPARATE column from `error`
  // deliberately: `error` answers "why couldn't this be placed on a conversation", and a body-fetch
  // failure is an independent axis. Conflating them would make the unresolved view start reporting
  // fetch faults as resolution faults. Null with a null body = not attempted yet.
  body_error          String?
  // WHO PRESSED SEND. Null = the system emitted it (a quote going out, the receipt cron) — that is
  // a different act from a person deciding to contact a customer, and the null is the distinction.
  sent_by_user        String?
  // 'out' | 'in'. Was derived-and-always-outbound until inbound existed; now a real field, because
  // the answer varies. Defaults 'out' so every historical row keeps its correct meaning.
  direction           String    @default("out")
  /**
   * DOES THIS SPEND THE GARAGE'S SMS ALLOWANCE? Frozen at send time, never re-derived.
   * False for `security: true` templates — a phone verification code is OUR account security, not
   * the garage's customer messaging, and it is neither counted nor refused. Stored rather than
   * looked up from the template registry at read time because a template's security flag can change
   * and history must not change with it: what a garage was charged in March is a fact about March.
   * Email rows carry `true` and are simply never queried by lib/sms-allowance.
   */
  counts_to_allowance Boolean   @default(true)
  // When the message ARRIVED (inbound only). sent_at is meaningless for a message we did not send
  // and stays null — the absence is the distinction, not a copied timestamp.
  received_at         DateTime?

  // What this send was ABOUT, for support ("resend the quote link for card X"). Loose by design —
  // a notification must never own a hard FK that blocks deleting the thing it referred to.
  subject_type String? // 'job_card' | 'user' | 'invoice' | …
  subject_id   String?

  created_at DateTime  @default(now())
  sent_at    DateTime? // when the provider accepted it

  // The conversation this message belongs to. NULLABLE and honestly so: a staff invite, an operator
  // email or a garage-facing alert is NOT a customer conversation, and a null here says exactly that
  // — it is not an orphan awaiting repair. NotificationLog remains THE single record of what was
  // sent; the thread is an index over it, never a second copy.
  thread_id String?

  group  Group?         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  thread MessageThread? @relation(fields: [thread_id], references: [id], onDelete: SetNull)
  // NO (direction, thread_id) INDEX. It existed from 20260731220000_inbound_email until
  // 20260816094000_drop_dead_notification_index removed it on evidence: zero scans, ever.
  // `direction` holds two values, so it is a useless leading column; thread-scoped reads are served
  // by (thread_id, created_at) above. If inbound work ever needs to filter a thread by direction,
  // the index to add is (group_id, recipient, created_at) — NOT this one. See the migration.

  @@index([group_id, created_at])
  @@index([provider_message_id])
  @@index([subject_type, subject_id])
  @@index([thread_id, created_at])
}

// ── MESSAGE THREADS ───────────────────────────────────────────────────────────────────────────────
// One conversation per (tenant, customer, vehicle). An INDEX over NotificationLog, not a second log:
// no message body lives here, and deleting a thread would lose nothing but the grouping.
//
// KEYED ON CUSTOMER **AND** VEHICLE, deliberately. Ownership transfer has never been performed in
// this codebase (no writer sets is_current false or valid_to; 160 edges, 160 current), so today this
// is indistinguishable from keying on the vehicle alone. It stops being indistinguishable the moment
// transfer is built: a car changing hands must NOT hand the new owner the old owner's messages.
// Paying that cost now is cheaper than migrating a mis-keyed thread table later.
//
// The customer is resolved the way the JOB CARD resolves it — through the current VehicleOwnership
// edge (lib/vehicle-identity::getCurrentOwnerId), never through JobCard.customer_id, which is
// nullable and is not the source of truth for ownership.
model MessageThread {
  id          String @id @default(uuid())
  group_id    String
  customer_id String
  vehicle_id  String

  // Per-thread inbound token — the half of the address that makes resolution EXACT. Random and
  // rotatable for the same reasons as the tenant token.
  thread_token           String?   @unique
  // Denormalised for the list view — derived from the messages, never authored.
  last_message_at        DateTime?
  // Direction of the MOST RECENT message. Derived in touchThread from the log, never authored.
  // 'in' here is what "unresponded" means: the customer spoke last and nobody has answered.
  last_message_direction String?
  /**
   * INBOUND messages not yet read. REAL — lib/inbound increments it on every resolved inbound
   * message, markThreadRead clears it, and the admin sidebar polls the tenant total.
   * This comment previously said the count was "structurally 0 today: there is no inbound path
   * anywhere in the product… a thing that cannot yet happen". True when written; the inbound-email
   * webhook shipped on 2026-07-31 and made it false the same day, and nobody came back. A comment
   * asserting that something is IMPOSSIBLE has a shelf life, because it is a claim about the whole
   * codebase made in one file — and unlike an assertion in a gate, nothing re-checks it.
   */
  unread_count           Int       @default(0)
  // 'open' | 'resolved'. No assignment to individual staff in v1 — a thread belongs to the garage.
  state                  String    @default("open")
  // WHO read it last, and when. Clearing unread is an act by a person and is attributed like one.
  last_read_at           DateTime?
  last_read_by           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group    Group             @relation(fields: [group_id], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle           @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  messages NotificationLog[]

  @@unique([group_id, customer_id, vehicle_id])
  @@index([group_id, state, last_message_at])
}

// ── MAGIC-LINK CUSTOMER AUTH (slice-1 B) ──────────────────────────────────────────────────────────
// A capability URL handed to a CUSTOMER (not a User — customers have no account). Same discipline as
// the operator invite: long random token, only its SHA-256 hash stored, so a DB leak yields nothing
// usable. Bound to ONE job card and ONE purpose — a quote link can never be replayed against the
// portal, and a link for card A can never open card B.
//
// ⚠️ THE LINK IS THE CREDENTIAL. Anyone holding the URL can view what it grants — there is no second
// factor and no identity proof. That is the deliberate trade (customers will not create accounts to
// approve a quote). It is why the grant is narrow (one card, one purpose), time-boxed (14 days), and
// read-oriented. Never let a magic link authorise a money movement or a destructive action.
//
// NOT single-use: a customer re-opening the same email must still work, so `consumed_at` records the
// FIRST use and `use_count` every use — consumption is recorded, not burned.
enum MagicLinkPurpose {
  quote_view // view + approve/decline a quote for one job card
  portal_view // customer portal view of one job card — NO ROUTE YET, deliberately dark
  invoice_pay // view ONE frozen invoice and (later) pay it — see CustomerMagicLink.invoice_id
  /// The intake report: the walkaround, the damage photos, and the findings, with a per-item
  /// answer. Read-and-answer, not read-only — but it carries NO PRICES, so a "yes" is
  /// "quote me for this" and acceptance still happens on a quote link.
  intake_report
}

model CustomerMagicLink {
  id          String           @id @default(uuid())
  group_id    String
  job_card_id String
  purpose     MagicLinkPurpose

  token_hash     String    @unique // sha256(raw) — the raw token exists only in the emailed URL
  expires_at     DateTime
  revoked_at     DateTime? // explicit kill switch (card cancelled, sent to the wrong address)
  // WHY it was killed — it decides the sentence the customer reads. One `revoked` bucket used to
  // tell everyone "this quote has been updated, ask for the current version", which is false for an
  // invoiced job: nothing was updated and there is no current version to ask for.
  // NULL is honest, not missing: every row written before 2026-08-08, plus states with no true
  // reason word, get the neutral sentence rather than a guessed one.
  revoked_reason String? // 'superseded' | 'invoiced' | 'declined' | 'cancelled' (see lib/magic-link)

  /**
   * THE INVOICE this link opens, for `invoice_pay`. NULL for every other purpose.
   * WHY NOT RESOLVE THROUGH THE CARD. An invoice FREEZES at issue; the job card keeps moving —
   * it can be unlocked, corrected, re-issued, and it can carry more than one invoice over its
   * life. A pay link resolved card-first would drift off the document it was minted for and
   * eventually name the wrong money. The link is bound to the artefact, not to the job.
   */
  invoice_id String?

  recipient    String // who it was sent to, for the audit answer "who could see this?"
  consumed_at  DateTime? // FIRST use
  last_used_at DateTime?
  use_count    Int       @default(0)

  created_at      DateTime @default(now())
  created_by_user String? // the staff User who caused it to be issued (null = system)

  group    Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  job_card JobCard  @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([group_id, job_card_id])
  @@index([invoice_id])
  @@index([expires_at])
}

// ── QUOTE VERSIONS (slice-2) ──────────────────────────────────────────────────────────────────────
// A quote is SENT as a FROZEN VERSION, never as a live pointer at the card's estimate. Acceptance
// has to refer to specific figures: if the garage edits the estimate afterwards, what the customer
// agreed to must still be recoverable, exactly. So each send snapshots the lines + totals into a
// numbered version; editing and re-sending mints version n+1, supersedes n, and REVOKES n's magic
// link so the old figures can never be accepted after the fact.
//
// THE ACCEPTED VERSION IS WHAT BECOMES THE INVOICE (lib/invoice-issue::snapshotInvoiceLines copies
// from it when one exists). That is the anti-drift guarantee: the customer is billed the rows they
// accepted, identical by construction — not because two renderers happened to agree.
enum QuoteVersionStatus {
  sent // out with the customer, awaiting a response
  accepted // customer accepted — frozen forever as the record of what was agreed
  declined // customer declined
  superseded // a newer version was sent; this one's link is revoked
}

model QuoteVersion {
  id          String             @id @default(uuid())
  group_id    String
  job_card_id String
  version     Int // 1-based, per card
  status      QuoteVersionStatus @default(sent)

  // Totals frozen at SEND, in pennies — never recomputed from live rows.
  net_pennies    Int
  vat_pennies    Int
  gross_pennies  Int
  // VAT treatment frozen at send, exactly as the invoice freezes vat_registered_at_issue.
  vat_registered Boolean
  tax_label      String  @default("VAT")

  sent_at         DateTime @default(now())
  sent_to         String? // the address it was emailed to; null = link handed over by hand
  // The operator's note explaining THIS revision — why the price moved. Belongs to the version
  // because it explains that version: v4's note must never surface on v6. Optional, always.
  // EMAIL + the customer's quote page only; deliberately never in the SMS, where any useful note
  // breaks the one-segment budget and a truncated explanation is worse than none.
  note            String?
  magic_link_id   String? // the credential minted for THIS version
  created_by_user String?

  // ── Response, audit-grade. Same weight as the rep agreement's click-sign: WHICH version, WHEN,
  // from WHAT IP and user-agent — so a disputed price has an attributable, frozen answer. ──
  responded_at         DateTime?
  responded_ip         String?
  responded_user_agent String?
  // WHO answered, and therefore HOW MUCH THE RECORD IS WORTH. NULL with responded_at set = the
  // CUSTOMER answered through their magic link (attested: ip + user-agent captured). SET = a staff
  // user recorded an answer taken by phone or over the counter — genuine, but garage-recorded, not
  // customer-attested. Never fake an ip/user-agent for that path; the absence is the honest signal.
  responded_by_user    String?

  group    Group              @relation(fields: [group_id], references: [id], onDelete: Cascade)
  job_card JobCard            @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  lines    QuoteVersionLine[]

  @@unique([job_card_id, version])
  @@index([group_id, job_card_id])
  @@index([status])
}

// The frozen line snapshot. Mirrors InvoiceLine's money columns so the copy into InvoiceLine at
// issue is field-for-field — no arithmetic in between, nothing to round differently.
model QuoteVersionLine {
  id                String   @id @default(uuid())
  quote_version_id  String
  position          Int
  item_type         ItemType
  description       String
  qty               Decimal  @db.Decimal(12, 2)
  unit_price        Decimal  @db.Decimal(12, 2)
  vat_rate          Decimal  @db.Decimal(5, 2)
  line_vat          Decimal  @db.Decimal(12, 2)
  line_total        Decimal  @db.Decimal(12, 2)
  // Internal grain, carried so the invoice freeze stays lossless. NEVER rendered to a customer.
  unit_cost         Decimal? @db.Decimal(12, 2)
  labour_hours      Decimal? @db.Decimal(6, 2)
  labour_outsourced Boolean  @default(false)

  quote_version QuoteVersion @relation(fields: [quote_version_id], references: [id], onDelete: Cascade)

  @@index([quote_version_id, position])
}

// COMING-SOON WAITLIST (country-first onboarding). When a visitor picks an unsupported country the
// flow ends on a friendly gate and captures their email here, WITH the country — so demand by
// country is directly queryable (GROUP BY country_code). group_id is set when the capture happens
// mid-onboarding (an account already exists); null otherwise.
model CountryWaitlist {
  id           String   @id @default(uuid())
  email        String
  country_code String // ISO 3166-1 alpha-2 of the unsupported country they asked for
  group_id     String?
  created_at   DateTime @default(now())

  group Group? @relation(fields: [group_id], references: [id], onDelete: SetNull)

  @@index([country_code, created_at])
}

/**
 * A CREDIT NOTE: an immutable VAT correction against an immutable invoice.
 *
 * ── WHY IT IS NOT A FLAG, A STATUS, OR A FOURTH InvoiceSeries ───────────────────────────────────
 * The tempting shape is `series: 'credit_note'` on Invoice. It is wrong: every reader of an Invoice
 * row treats it as something PAYABLE. `refuseIfVoid`, `offersPayLink`, the debtors list,
 * `receivedInPeriod`, `amendmentRequirement` and the pay-link mint would each need "…unless it is a
 * credit note", which is eight chances to forget. A credit note is never paid; it is issued.
 *
 * ── WHAT IT DOES AND DOES NOT DO ────────────────────────────────────────────────────────────────
 * It reverses OUTPUT VAT. It does not move money — a Refund does that, and the two are deliberately
 * separate because they answer different questions on different clocks: the refund lands in the
 * month the money left (the CASH clock, lib/payments::receivedInPeriod) and the credit note lands
 * in the VAT period of its own date (the VAT clock). Both are correct. They are allowed to differ,
 * and the accountant's ruling (2026-08-16) is that they SHOULD be allowed to.
 *
 * ── THE DATE IS CONFIRMED, NEVER ADOPTED SILENTLY ───────────────────────────────────────────────
 * `date_issued` defaults to the refund's date at the surface and is confirmed by a person before
 * the document exists. An automatically-issued document silently picks a TAX POINT, and the whole
 * reason the two clocks are allowed to differ is that the choice must be visible.
 *
 * ── IT DOES NOT MOVE THE JOB CARD ───────────────────────────────────────────────────────────────
 * Same rule as a refund: a credit note is a fact about a document, not about the work.
 */
model CreditNote {
  id       String @id @default(uuid())
  group_id String
  site_id  String
  /// The invoice being corrected. REQUIRED — a credit note that names no invoice corrects nothing,
  /// and this is the structural limit that stops it becoming a way to invent negative output tax.
  invoice_id String

  /// Its OWN number, from its OWN counter (InvoiceSequence.credit_note_last_value).
  sequence_value Int
  credit_note_number String

  /// THE VAT-CLOCK DATE. Confirmed by a person; defaults to the refund date at the surface.
  date_issued DateTime
  /// Wall-clock of the write. Distinct from date_issued for the same reason Payment.collected_at is
  /// distinct from created_at: one is the document's date, the other is when someone pressed a key.
  issued_at   DateTime @default(now())

  /// Why. Mandatory at the surface — a correction nobody can explain is a correction nobody can audit.
  reason   String
  /// Which refund occasioned it, when one did. NULL for a correction with no money movement (a
  /// figure corrected before anything was paid) — a MEANINGFUL absence, not a forgotten one.
  refund_id String?

  /// Frozen at issue, exactly as InvoiceLine is. Never recomputed.
  vat_registered_at_issue    Boolean
  company_name_snapshot      String
  /// NULL when the invoice carried none — the tenant was not registered at issue. Copied from the
  /// invoice, never re-resolved: a credit note must show the same particulars as what it corrects.
  company_vat_number_snapshot String?
  /// NULL when the invoice had none. Same copy-not-resolve rule as the VAT number above.
  company_address_snapshot   String?
  /// The TRADING name as it stood at issue. Frozen for the same reason every other snapshot here is:
  /// a garage that rebrands must not have every historical document reprint under the new name — an
  /// invoice is a record of what the customer received, not a view of who the garage is today. Same
  /// failure shape as a labour rate revaluing closed months.
  ///
  /// NULL is TEMPORAL and honest: rows issued before this column existed genuinely carried no
  /// trading name, and the renderer falls back to company_name_snapshot for them rather than
  /// pretending. It is not "a caller forgot" — the mint always writes it now.
  company_trading_name_snapshot String?
  customer_name_snapshot     String
  /// NULL when the customer had no address on the invoice. A meaningful absence: plenty of
  /// counter jobs never collect one, and inventing one on the correction would differ from the
  /// document being corrected.
  customer_address_snapshot  String?
  /// COPIED FROM THE INVOICE, like every other particular here. A credit note that reverted to the
  /// employee's name while the invoice it corrects is addressed to their employer would not read as
  /// a pair — which is the one thing this whole block of columns exists to guarantee.
  account_name_snapshot      String?
  account_address_snapshot   String?

  /// NULL when the system issued it rather than a person — the same convention Payment uses.
  /// The `refund.requested` audit row carries WHO for the person-initiated case.
  created_by String?
  created_at DateTime @default(now())

  group   Group            @relation(fields: [group_id], references: [id], onDelete: Cascade)
  invoice Invoice          @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  refund  Refund?          @relation(fields: [refund_id], references: [id], onDelete: SetNull)
  lines   CreditNoteLine[]

  @@unique([group_id, sequence_value])
  @@index([group_id, date_issued])
  @@index([invoice_id])
}

/// Frozen lines, the same grain as InvoiceLine. POSITIVE amounts: the document's SIGN is carried by
/// its type, not by negative numbers on the rows — a negative qty on a line is how a reader ends up
/// double-negating. lib/vat-summary SUBTRACTS these.
model CreditNoteLine {
  id             String  @id @default(uuid())
  credit_note_id String
  position       Int
  description    String
  item_type      ItemType
  qty            Decimal @db.Decimal(12, 2)
  unit_price     Decimal @db.Decimal(12, 2)
  vat_rate       Decimal @db.Decimal(5, 2)
  line_total     Decimal @db.Decimal(12, 2)
  line_vat       Decimal @db.Decimal(12, 2)

  credit_note CreditNote @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)

  @@index([credit_note_id])
}
