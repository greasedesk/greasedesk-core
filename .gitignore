# Build Artifacts
/public/build
/public/next-auth-static # Added NextAuth specific artifacts

# Prisma Artifacts
/prisma/dev.db # Excludes SQLite development DBs if used
/prisma/*.sqlite
/prisma/migrations/ # Excludes migration files if you use 'prisma migrate' (Use 'db push' instead for simplicity)

# TypeScript
*.tsbuildinfo

# Logs & Cache..
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store # Added Mac OS cache files (important for Mac users like you).DS_Store
public/pdfjs/
.commission-gate-tmp/

# THROWAWAY gate/verify scripts only (run from the repo dir for node_modules resolution).
# `_tmp-`, NOT `_*`: the old pattern also swallowed scripts/_gate-preflight.mjs, _ts.mjs,
# _ts-hook.mjs and _gate-retry.mjs — the shared helpers that 86, 81, 2 and 3 gates import.
# Every committed gate depended on files that were not in the repo, so a fresh clone could
# not run a single one. Name a throwaway `_tmp-<what>.mjs` and it stays ignored.
_tmp-*.mjs
.vercel

# The gate runner writes results here as it goes, so a run can resume. Local state.
.gate-results.json
